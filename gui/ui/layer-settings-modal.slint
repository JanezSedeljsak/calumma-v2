import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmScrollView } from "calm/CalmScrollView.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { LayerSettingsBody } from "layer-settings-body.slint";
import { LayerChrome } from "layer-chrome.slint";

export component LayerSettingsModal inherits Rectangle {
    in-out property <bool> open;
    in property <length> board-x;
    in property <length> board-y;
    in property <length> board-width;
    in property <length> board-height;


    private property <length> card-max-height: max(Tokens.control-height * 8, root.board-height - Tokens.space-md * 2);

    out property <length> card-x: card.absolute-position.x;
    out property <length> card-y: card.absolute-position.y;
    out property <length> card-width: card.width;
    out property <length> card-height: card.height;
    out property <length> card-radius: card.border-radius;

    width: 100%;
    height: 100%;
    visible: root.open;

    if root.open: CalmPointer {
        x: root.board-x;
        y: root.board-y;
        width: root.board-width;
        height: root.board-height;
        clicked => {
            root.open = false;
            LayerChrome.settings-dismissed();
        }
    }

    card := Rectangle {
        visible: root.open;
        z: 2;
        width: Tokens.layer-settings-card-width;
        height: min(body.preferred-height + Tokens.space-md * 2, root.card-max-height);
        x: root.board-x + root.board-width - self.width - Tokens.space-md;
        y: root.board-y + (root.board-height - self.height) / 2;
        background: Theme.surface;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Theme.island-border;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.shadow;
        clip: true;

        dismiss-swallow := CalmPointer { }

        CalmScrollView {
            x: Tokens.space-md;
            y: Tokens.space-md;
            width: parent.width - Tokens.space-md * 2;
            height: parent.height - Tokens.space-md * 2;

            body := LayerSettingsBody {
                compact: false;
            }
        }
    }
}
