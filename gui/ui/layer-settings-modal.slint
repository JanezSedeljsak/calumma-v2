import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmModal, CalmModalCard } from "calm/CalmModal.slint";
import { CalmDivider } from "calm/CalmDivider.slint";
import { CalmButton } from "calm/CalmButton.slint";
import { CalmToggle } from "calm/CalmToggle.slint";
import { CalmBody, CalmMuted } from "calm/CalmText.slint";

export component LayerSettingsModal inherits Rectangle {
    in-out property <bool> open;
    in property <string> layer-name;
    in property <bool> layer-visible;
    in property <bool> can-delete;

    in property <string> visibility-label;
    in property <string> export-label;
    in property <string> duplicate-label;
    in property <string> delete-label;

    callback dismissed();
    callback toggle-visibility();
    callback export-layer();
    callback duplicate-layer();
    callback delete-layer();

    width: 100%;
    height: 100%;
    visible: open;

    CalmModal {
        open <=> root.open;
        dismissed => {
            root.dismissed();
        }

        CalmModalCard {
            width: 260px;
            height: card.preferred-height;
            background: Theme.surface;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            card := VerticalLayout {
                padding: Tokens.space-md;
                spacing: Tokens.space-md;

                CalmBody {
                    text: root.layer-name;
                    strong: true;
                    overflow: elide;
                }

                HorizontalLayout {
                    CalmMuted {
                        text: root.visibility-label;
                        horizontal-stretch: 1;
                    }
                    CalmToggle {
                        checked: root.layer-visible;
                        y: (parent.height - self.height) / 2;
                        toggled => {
                            root.toggle-visibility();
                        }
                    }
                }

                CalmDivider { }

                HorizontalLayout {
                    spacing: Tokens.space-sm;

                    CalmButton {
                        text: root.export-label;
                        fill: true;
                        clicked => {
                            root.export-layer();
                        }
                    }

                    CalmButton {
                        text: root.duplicate-label;
                        fill: true;
                        clicked => {
                            root.duplicate-layer();
                        }
                    }
                }

                if root.can-delete: CalmDivider { }

                if root.can-delete: CalmButton {
                    text: root.delete-label;
                    fill: true;
                    has-tint: true;
                    tint: Theme.danger;
                    clicked => {
                        root.delete-layer();
                    }
                }
            }
        }
    }
}
