import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmToolButton } from "calm/CalmToolButton.slint";
import { CalmSliderRow } from "calm/CalmSliderRow.slint";
import { CalmToggle } from "calm/CalmToggle.slint";
import { CalmMuted } from "calm/CalmText.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { ToolEntry } from "models.slint";
import { ToolChrome } from "tool-chrome.slint";

component OptionChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;

    callback clicked();

    height: Tokens.control-height;
    min-width: chip-label.preferred-width + Tokens.space-xs * 2;
    horizontal-stretch: 1;
    border-radius: Tokens.radius-sm;
    background: root.selected ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: root.selected ? Theme.control-focus-border : Theme.control-border;

    CalmPointer {
        clicked => {
            root.clicked();
        }
    }

    chip-label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.selected ? Theme.text : Theme.text-muted;
        font-size: Tokens.label-size;
        font-weight: 500;
    }
}

component OptionToggle inherits HorizontalLayout {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;

    callback toggled();

    spacing: Tokens.space-xs;

    CalmMuted {
        text: root.label;
        horizontal-stretch: 1;
        overflow: elide;
        opacity: root.enabled ? 1.0 : Tokens.disabled-opacity;
    }

    CalmToggle {
        checked: root.checked;
        y: (parent.height - self.height) / 2;
        opacity: root.enabled ? 1.0 : Tokens.disabled-opacity;
        toggled => {
            if (root.enabled) {
                root.toggled();
            }
        }
    }
}

component SubGrid inherits VerticalLayout {
    in property <[ToolEntry]> tools;
    in property <[image]> icons;

    callback pick(int);

    spacing: Tokens.space-sm;

    for row in [0, 1, 2]: HorizontalLayout {
        spacing: Tokens.space-sm;

        for column in [0, 1]: Rectangle {
            horizontal-stretch: 1;
            height: Tokens.tool-button-size;

            if row * 2 + column < root.tools.length: CalmToolButton {
                x: (parent.width - self.width) / 2;
                icon: root.icons[root.tools[row * 2 + column].icon];
                tip: root.tools[row * 2 + column].tip;
                shortcut: root.tools[row * 2 + column].shortcut;
                enabled: root.tools[row * 2 + column].enabled;
                selected: root.tools[row * 2 + column].selected;
                clicked => {
                    root.pick(root.tools[row * 2 + column].id);
                }
            }
        }
    }
}

export component ToolOptions inherits VerticalLayout {
    in property <[image]> tool-icons;
    in property <[image]> brush-icons;

    callback pick-tool(int);
    callback pick-brush(int);
    callback brush-size-changed(float);
    callback brush-size-committed(string);
    callback ink-opacity-changed(float);
    callback blur-changed(float);
    callback hardness-changed(float);
    callback tolerance-changed(float);
    callback eyedropper-changed(float);
    callback fill-toggled();
    callback stroke-toggled();
    callback vector-toggled();
    callback aligned-toggled();
    callback transform-toggled();
    callback crop-aspect-changed(int);
    callback crop-overlay-changed(int);
    callback commit-crop();
    callback cancel-crop();

    spacing: Tokens.space-xs;

    if ToolChrome.show-shapes: SubGrid {
        tools: ToolChrome.shape-tools;
        icons: root.tool-icons;
        pick(id) => {
            root.pick-tool(id);
        }
    }

    if ToolChrome.show-selection: SubGrid {
        tools: ToolChrome.select-tools;
        icons: root.tool-icons;
        pick(id) => {
            root.pick-tool(id);
        }
    }

    if ToolChrome.show-brushes: HorizontalLayout {
        spacing: Tokens.space-sm;

        for column in [0, 1]: Rectangle {
            horizontal-stretch: 1;
            height: Tokens.tool-button-size;

            if column < ToolChrome.brush-tools.length: CalmToolButton {
                x: (parent.width - self.width) / 2;
                icon: root.brush-icons[ToolChrome.brush-tools[column].icon];
                tip: ToolChrome.brush-tools[column].tip;
                selected: ToolChrome.brush-tools[column].selected;
                clicked => {
                    root.pick-brush(ToolChrome.brush-tools[column].id);
                }
            }
        }
    }

    if ToolChrome.show-brushes: HorizontalLayout {
        spacing: Tokens.space-sm;

        for column in [2, 3]: Rectangle {
            horizontal-stretch: 1;
            height: Tokens.tool-button-size;

            if column < ToolChrome.brush-tools.length: CalmToolButton {
                x: (parent.width - self.width) / 2;
                icon: root.brush-icons[ToolChrome.brush-tools[column].icon];
                tip: ToolChrome.brush-tools[column].tip;
                selected: ToolChrome.brush-tools[column].selected;
                clicked => {
                    root.pick-brush(ToolChrome.brush-tools[column].id);
                }
            }
        }
    }

    if ToolChrome.show-brush-size: CalmSliderRow {
        label: ToolChrome.brush-size-label;
        value-text <=> ToolChrome.brush-size-text;
        editable: true;
        value <=> ToolChrome.brush-size-unit;
        moved(v) => {
            root.brush-size-changed(v);
        }
        committed(text) => {
            root.brush-size-committed(text);
        }
    }

    if ToolChrome.show-ink-opacity: CalmSliderRow {
        label: ToolChrome.ink-opacity-label;
        value-text: ToolChrome.ink-opacity-text;
        value <=> ToolChrome.ink-opacity;
        moved(v) => {
            root.ink-opacity-changed(v);
        }
    }

    if ToolChrome.show-blur: CalmSliderRow {
        label: ToolChrome.blur-label;
        value-text: ToolChrome.blur-text;
        value <=> ToolChrome.blur-strength;
        moved(v) => {
            root.blur-changed(v);
        }
    }

    if ToolChrome.show-hardness: CalmSliderRow {
        label: ToolChrome.hardness-label;
        value-text: ToolChrome.hardness-text;
        value <=> ToolChrome.eraser-hardness;
        moved(v) => {
            root.hardness-changed(v);
        }
    }

    if ToolChrome.show-tolerance: CalmSliderRow {
        label: ToolChrome.tolerance-label;
        value-text: ToolChrome.tolerance-text;
        minimum: 0;
        maximum: 128;
        value <=> ToolChrome.tolerance-unit;
        moved(v) => {
            root.tolerance-changed(v);
        }
    }

    if ToolChrome.show-eyedropper: VerticalLayout {
        spacing: 2px;

        CalmSliderRow {
            label: ToolChrome.sample-label;
            value-text: ToolChrome.eyedropper-text;
            minimum: 0;
            maximum: 15;
            value <=> ToolChrome.eyedropper-radius;
            moved(v) => {
                root.eyedropper-changed(v);
            }
        }

        Rectangle {
            height: 28px;

            Rectangle {
                width: 8px + ToolChrome.eyedropper-radius / 15 * 20px;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: Theme.accent-teal.with-alpha(0.35);
                border-width: 1px;
                border-color: Theme.text-muted;
            }
        }
    }

    if ToolChrome.show-fill: OptionToggle {
        label: ToolChrome.fill-label;
        checked: ToolChrome.fill-on;
        toggled => {
            root.fill-toggled();
        }
    }

    if ToolChrome.show-fill: OptionToggle {
        label: ToolChrome.stroke-label;
        checked: ToolChrome.stroke-on;
        toggled => {
            root.stroke-toggled();
        }
    }

    if ToolChrome.show-vector: OptionToggle {
        label: ToolChrome.vector-label;
        checked: ToolChrome.vector-on;
        enabled: !ToolChrome.vector-locked;
        toggled => {
            root.vector-toggled();
        }
    }

    if ToolChrome.show-aligned: OptionToggle {
        label: ToolChrome.aligned-label;
        checked: ToolChrome.clone-aligned;
        toggled => {
            root.aligned-toggled();
        }
    }

    if ToolChrome.show-transform: OptionToggle {
        label: ToolChrome.transform-label;
        checked: ToolChrome.transform-on;
        toggled => {
            root.transform-toggled();
        }
    }

    if ToolChrome.show-crop: CalmMuted {
        text: ToolChrome.crop-aspect-label;
    }

    if ToolChrome.show-crop: HorizontalLayout {
        spacing: Tokens.space-xs;

        OptionChip {
            label: ToolChrome.crop-free-label;
            selected: ToolChrome.crop-aspect == 0;
            clicked => {
                root.crop-aspect-changed(0);
            }
        }

        OptionChip {
            label: ToolChrome.crop-square-label;
            selected: ToolChrome.crop-aspect == 1;
            clicked => {
                root.crop-aspect-changed(1);
            }
        }
    }

    if ToolChrome.show-crop: HorizontalLayout {
        spacing: Tokens.space-xs;

        OptionChip {
            label: "4:3";
            selected: ToolChrome.crop-aspect == 2;
            clicked => {
                root.crop-aspect-changed(2);
            }
        }

        OptionChip {
            label: "16:9";
            selected: ToolChrome.crop-aspect == 3;
            clicked => {
                root.crop-aspect-changed(3);
            }
        }
    }

    if ToolChrome.show-crop: CalmMuted {
        text: ToolChrome.crop-overlay-label;
    }

    if ToolChrome.show-crop: HorizontalLayout {
        spacing: Tokens.space-xs;

        OptionChip {
            label: ToolChrome.crop-overlay-off-label;
            selected: ToolChrome.crop-overlay == 0;
            clicked => {
                root.crop-overlay-changed(0);
            }
        }

        OptionChip {
            label: ToolChrome.crop-overlay-thirds-label;
            selected: ToolChrome.crop-overlay == 1;
            clicked => {
                root.crop-overlay-changed(1);
            }
        }

        OptionChip {
            label: ToolChrome.crop-overlay-grid-label;
            selected: ToolChrome.crop-overlay == 2;
            clicked => {
                root.crop-overlay-changed(2);
            }
        }
    }

    if ToolChrome.show-crop: HorizontalLayout {
        spacing: Tokens.space-xs;

        OptionChip {
            label: ToolChrome.crop-overlay-diagonal-label;
            selected: ToolChrome.crop-overlay == 3;
            clicked => {
                root.crop-overlay-changed(3);
            }
        }

        OptionChip {
            label: ToolChrome.crop-overlay-golden-label;
            selected: ToolChrome.crop-overlay == 4;
            clicked => {
                root.crop-overlay-changed(4);
            }
        }
    }

    if ToolChrome.show-crop: HorizontalLayout {
        spacing: Tokens.space-xs;

        OptionChip {
            label: ToolChrome.crop-cancel-label;
            clicked => {
                root.cancel-crop();
            }
        }

        OptionChip {
            label: ToolChrome.crop-commit-label;
            selected: true;
            clicked => {
                root.commit-crop();
            }
        }
    }
}
