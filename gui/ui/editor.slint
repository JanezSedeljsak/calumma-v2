import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmIsland } from "calm/CalmIsland.slint";
import { ToolsPanel } from "tools-panel.slint";
import { LayersPanel } from "layers-panel.slint";
import { LayerHoverCard } from "layer-hover-card.slint";
import { LayerListChrome } from "layer-list-chrome.slint";
import { GuideChrome } from "guide-chrome.slint";
import { AlignIsland } from "align-island.slint";
import { LayerChrome } from "layer-chrome.slint";
import { ZoomPill } from "zoom-pill.slint";
import { CanvasSkeleton } from "canvas-skeleton.slint";
import { RulerStrip } from "ruler.slint";
import { GuidesCorner, GuideReadout } from "guide-ruler-chrome.slint";

export component Editor inherits Rectangle {
    in property <bool> layers-open;
    in property <bool> layer-settings-open;

    in property <bool> loading;
    in property <length> loading-paper-x;
    in property <length> loading-paper-y;
    in property <length> loading-paper-width;
    in property <length> loading-paper-height;

    out property <length> board-x: board-surface.absolute-position.x;
    out property <length> board-y: board-surface.absolute-position.y;
    out property <length> board-width: board-surface.width;
    out property <length> board-height: board-surface.height;
    out property <length> zoom-chrome-x: zoom-pill.absolute-position.x;
    out property <length> zoom-chrome-y: zoom-pill.absolute-position.y;
    out property <length> zoom-chrome-width: zoom-pill.width;
    out property <length> zoom-chrome-height: zoom-pill.height;
    out property <length> zoom-chrome-radius: zoom-pill.border-radius;
    out property <length> hover-chrome-x: hover-card.absolute-position.x;
    out property <length> hover-chrome-y: hover-card.absolute-position.y;
    out property <length> hover-chrome-width: hover-card.width;
    out property <length> hover-chrome-height: hover-card.height;
    out property <length> hover-chrome-radius: hover-card.border-radius;

    function strip-to-board-x(strip-x: length, local-x: length) -> float {
        (strip-x + local-x - board-surface.absolute-position.x) / 1px;
    }

    function strip-to-board-y(strip-y: length, local-y: length) -> float {
        (strip-y + local-y - board-surface.absolute-position.y) / 1px;
    }

    callback pointer-pressed(float, float, bool, bool, bool, bool);
    callback pointer-moved(float, float);
    callback pointer-released(float, float);
    callback pointer-enter();
    callback pointer-exit();
    callback scrolled(float, float, float, float, bool, bool);
    callback pinch-started();
    callback pinch-updated(float, float, float);
    callback pinch-ended();

    background: Theme.bg;

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-left: Tokens.space-xs;
            padding-right: Tokens.space-xs;
            padding-bottom: Tokens.space-xs;
            padding-top: Tokens.titlebar-height;
            spacing: Tokens.space-xs;

        HorizontalLayout {
            spacing: Tokens.space-xs;
            vertical-stretch: 1;

            ToolsPanel {
                vertical-stretch: 1;
            }

            board-area := CalmIsland {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-width: 320px;
                island-padding: 0px;
                clip: true;

                VerticalLayout {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;

                    HorizontalLayout {
                        height: Tokens.ruler-thickness;

                        Rectangle {
                            width: Tokens.ruler-thickness;
                            background: Theme.surface;
                        }

                        h-ruler := RulerStrip {
                            horizontal-stretch: 1;
                            ticks: GuideChrome.ruler-ticks-x;
                            guide-pressed(x, y) => {
                                GuideChrome.pressed(true, root.strip-to-board-x(h-ruler.absolute-position.x, x), root.strip-to-board-y(h-ruler.absolute-position.y, y));
                            }
                            guide-moved(x, y) => {
                                GuideChrome.moved(root.strip-to-board-x(h-ruler.absolute-position.x, x), root.strip-to-board-y(h-ruler.absolute-position.y, y));
                            }
                            guide-released => {
                                GuideChrome.released();
                            }
                            has-guide(x, y) => {
                                return GuideChrome.ruler-has-guide(root.strip-to-board-x(h-ruler.absolute-position.x, x), root.strip-to-board-y(h-ruler.absolute-position.y, y));
                            }
                        }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;

                        v-ruler := RulerStrip {
                            width: Tokens.ruler-thickness;
                            vertical: true;
                            ticks: GuideChrome.ruler-ticks-y;
                            guide-pressed(x, y) => {
                                GuideChrome.pressed(false, root.strip-to-board-x(v-ruler.absolute-position.x, x), root.strip-to-board-y(v-ruler.absolute-position.y, y));
                            }
                            guide-moved(x, y) => {
                                GuideChrome.moved(root.strip-to-board-x(v-ruler.absolute-position.x, x), root.strip-to-board-y(v-ruler.absolute-position.y, y));
                            }
                            guide-released => {
                                GuideChrome.released();
                            }
                            has-guide(x, y) => {
                                return GuideChrome.ruler-has-guide(root.strip-to-board-x(v-ruler.absolute-position.x, x), root.strip-to-board-y(v-ruler.absolute-position.y, y));
                            }
                        }

                        board-stack := Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.desk;

                            board-surface := Rectangle {
                                width: 100%;
                                height: 100%;

                                pinch := ScaleRotateGestureHandler {
                                        width: 100%;
                                        height: 100%;
                                        started => {
                                            root.pinch-started();
                                        }
                                        updated => {
                                            root.pinch-updated(board-touch.mouse-x / 1px, board-touch.mouse-y / 1px, self.scale);
                                        }
                                        ended => {
                                            root.pinch-ended();
                                        }
                                        cancelled => {
                                            root.pinch-ended();
                                        }

                                        board-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;

                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.move) {
                                                    root.pointer-moved(self.mouse-x / 1px, self.mouse-y / 1px);
                                                } else if (event.button == PointerEventButton.left || event.button == PointerEventButton.middle) {
                                                    if (event.kind == PointerEventKind.down) {
                                                        root.pointer-pressed(
                                                            self.mouse-x / 1px,
                                                            self.mouse-y / 1px,
                                                            event.button == PointerEventButton.middle,
                                                            event.modifiers.meta || event.modifiers.control,
                                                            event.modifiers.alt,
                                                            event.modifiers.shift,
                                                        );
                                                    } else if (event.kind == PointerEventKind.up) {
                                                        root.pointer-released(self.mouse-x / 1px, self.mouse-y / 1px);
                                                    }
                                                }
                                            }

                                            scroll-event(event) => {
                                                root.scrolled(
                                                    self.mouse-x / 1px,
                                                    self.mouse-y / 1px,
                                                    event.delta-x / 1px,
                                                    event.delta-y / 1px,
                                                    event.modifiers.alt,
                                                    event.modifiers.meta || event.modifiers.control,
                                                );
                                                accept;
                                            }
                                        }
                                    }

                                    private property <bool> board-hovered: board-touch.has-hover;

                                    changed board-hovered => {
                                        if (self.board-hovered) {
                                            root.pointer-enter();
                                        } else {
                                            root.pointer-exit();
                                        }
                                    }
                            }

                            zoom-pill := ZoomPill {
                                visible: !root.layer-settings-open;
                                x: parent.width - self.width - Tokens.space-sm;
                                y: parent.height - self.height - Tokens.space-sm;
                                z: 2;
                            }

                            if root.loading: CanvasSkeleton {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                paper-x: root.loading-paper-x;
                                paper-y: root.loading-paper-y;
                                paper-width: root.loading-paper-width;
                                paper-height: root.loading-paper-height;
                            }
                        }
                    }
                }

                GuidesCorner {
                    x: 1px + Tokens.ruler-thickness / 2 - self.width / 2;
                    y: 1px + Tokens.ruler-thickness / 2 - self.height / 2;
                }

                if GuideChrome.readout-visible: GuideReadout {
                    x: GuideChrome.readout-horizontal
                        ? 1px + 2px
                        : min(max(1px + Tokens.ruler-thickness + 4px, 1px + Tokens.ruler-thickness + GuideChrome.readout-screen * 1px + 4px), parent.width - self.width - Tokens.space-sm);
                    y: GuideChrome.readout-horizontal
                        ? min(max(1px + Tokens.ruler-thickness, 1px + Tokens.ruler-thickness + GuideChrome.readout-screen * 1px - self.height / 2), parent.height - self.height - Tokens.space-sm)
                        : 1px + 2px;
                }
            }

            if root.layers-open: layers-slot := VerticalLayout {
                width: Tokens.layers-panel-width;
                spacing: Tokens.space-sm;

                if LayerChrome.align-visible: AlignIsland { }

                LayersPanel {
                    vertical-stretch: 1;
                }
            }
        }
    }

    hover-card := LayerHoverCard {
        visible: root.layers-open && LayerListChrome.hover-visible && !root.layer-settings-open;
        x: board-surface.absolute-position.x - root.absolute-position.x + board-surface.width - self.width - Tokens.space-md;
        y: board-surface.absolute-position.y - root.absolute-position.y + (board-surface.height - self.height) / 2;
        z: 8;
        layer-name: LayerListChrome.hover-name;
        preview: LayerListChrome.hover-image;
    }
}
