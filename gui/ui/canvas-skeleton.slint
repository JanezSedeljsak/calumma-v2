import { Theme } from "calm/CalmTheme.slint";
import { DeskGrid } from "desk-grid.slint";

export component CanvasSkeleton inherits Rectangle {
    in property <length> paper-x;
    in property <length> paper-y;
    in property <length> paper-width;
    in property <length> paper-height;

    clip: true;

    DeskGrid {
        width: 100%;
        height: 100%;
    }

    paper := Rectangle {
        x: root.paper-x;
        y: root.paper-y;
        width: root.paper-width;
        height: root.paper-height;
        background: Theme.paper;
        border-width: 1px;
        border-color: Theme.paper-border;
    }
}
