import { Tokens } from "calm/CalmTokens.slint";
import { ProjectTabs } from "project-tabs.slint";
import { ProjectTabRow } from "models.slint";

export component Titlebar inherits Rectangle {
    in property <bool> editor-open;
    in property <[ProjectTabRow]> project-tabs;
    in property <string> close-tip;
    in property <string> new-project-tip;

    callback switch-project-tab(string);
    callback close-project-tab(string);
    callback new-project();
    callback drag();
    callback zoom();

    height: Tokens.titlebar-height;
    background: transparent;

    HorizontalLayout {
        alignment: stretch;
        spacing: Tokens.space-xs;
        padding-right: Tokens.space-xs;

        Rectangle {
            width: Tokens.titlebar-leading;
        }

        if root.editor-open: ProjectTabs {
            y: (parent.height - self.height) / 2;
            tabs: root.project-tabs;
            close-tip: root.close-tip;
            new-project-tip: root.new-project-tip;
            switch-tab(id) => {
                root.switch-project-tab(id);
            }
            close-tab(id) => {
                root.close-project-tab(id);
            }
            new-project => {
                root.new-project();
            }
        }

        TouchArea {
            horizontal-stretch: 1;
            mouse-cursor: default;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.drag();
                }
            }
            double-clicked => {
                root.zoom();
            }
        }
    }
}
