import { Tokens } from "calm/CalmTokens.slint";
import { ProjectTabs } from "project-tabs.slint";
import { ProjectChrome } from "project-chrome.slint";
import { MenuChrome } from "menu-chrome.slint";

export component Titlebar inherits Rectangle {
    in property <bool> editor-open;

    callback drag();
    callback zoom();

    height: Tokens.titlebar-height;
    background: transparent;

    HorizontalLayout {
        alignment: stretch;
        spacing: Tokens.space-xs;
        padding-right: Tokens.space-xs;

        Rectangle {
            width: Tokens.titlebar-leading;
        }

        if root.editor-open: ProjectTabs {
            y: (parent.height - self.height) / 2;
            tabs: ProjectChrome.tabs;
            close-tip: ProjectChrome.close-tab-tip;
            new-project-tip: MenuChrome.new-project-title;
            switch-tab(id) => {
                ProjectChrome.switch-tab(id);
            }
            close-tab(id) => {
                ProjectChrome.close-tab(id);
            }
            edit-tab(id, anchor-x, anchor-y) => {
                ProjectChrome.edit-tab(id, anchor-x, anchor-y);
            }
            new-project => {
                MenuChrome.new-project();
            }
        }

        TouchArea {
            horizontal-stretch: 1;
            mouse-cursor: default;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.drag();
                }
            }
            double-clicked => {
                root.zoom();
            }
        }
    }
}
