import { LayerRow } from "models.slint";
import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmScrollView } from "calm/CalmScrollView.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmIsland } from "calm/CalmIsland.slint";
import { CalmDivider } from "calm/CalmDivider.slint";
import { CalmSurface } from "calm/CalmSurface.slint";
import { CalmIconButton } from "calm/CalmToolButton.slint";
import { CalmField } from "calm/CalmField.slint";
import { CalmBody, CalmLabel } from "calm/CalmText.slint";

component LayerThumb inherits Rectangle {
    in property <image> thumb;

    width: Tokens.layer-thumb-width;
    height: Tokens.layer-thumb-height;
    border-radius: Tokens.radius-sm;
    background: Theme.surface-hover;
    clip: true;

    Image {
        source: root.thumb;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }
}

component LayerListRow inherits HorizontalLayout {
    in property <LayerRow> layer-row;
    in property <image> icon-eye-open;
    in property <image> icon-eye-closed;
    in property <image> icon-more;
    in property <image> icon-trash;
    in property <string> visibility-tip;
    in property <string> settings-tip;
    in property <string> delete-tip;
    in property <bool> drop-target;
    in property <bool> dragging;

    callback row-clicked();
    callback toggle-visible();
    callback open-settings(float, float);
    callback delete-layer();
    callback rename-layer(string);
    callback hover-enter(length);
    callback hover-leave();
    callback drag-moved(length);
    callback drag-finished();

    spacing: Tokens.space-sm;
    alignment: stretch;
    height: Tokens.layer-thumb-height + Tokens.space-xs * 2;
    opacity: root.dragging ? 0.45 : 1.0;

    private property <bool> row-hovered: grab.has-hover || trash-hot.has-hover;
    private property <bool> drag-armed: false;
    private property <bool> renaming: false;
    private property <string> rename-draft: "";
    private property <length> press-x: 0px;
    private property <length> press-y: 0px;

    function commit-rename() {
        if (!root.renaming) {
            return;
        }
        root.renaming = false;
        root.rename-layer(root.rename-draft);
    }

    changed row-hovered => {
        if (root.dragging || root.renaming) {
            return;
        }
        if (root.row-hovered) {
            root.hover-enter(root.absolute-position.y);
        } else {
            root.hover-leave();
        }
    }

    card := CalmSurface {
        horizontal-stretch: 1;
        radius: Tokens.radius-sm;
        bordered: true;
        hover: root.layer-row.active || root.drop-target;
        focused: root.layer-row.active || root.drop-target;

        HorizontalLayout {
            padding-left: root.layer-row.clip-base ? Tokens.space-xl : Tokens.space-sm;
            padding-right: Tokens.space-sm;
            padding-top: Tokens.space-xs;
            padding-bottom: Tokens.space-xs;
            spacing: Tokens.space-sm;

            grab := CalmPointer {
                horizontal-stretch: 1;
                mouse-cursor: root.layer-row.paper || root.renaming ? pointer : (root.drag-armed ? MouseCursor.grabbing : MouseCursor.grab);
                pointer-event(event) => {
                    if (root.renaming) {
                        return;
                    }
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.press-x = self.mouse-x;
                        root.press-y = self.mouse-y;
                        root.drag-armed = false;
                    }
                    if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                        if (root.drag-armed) {
                            root.drag-finished();
                        } else {
                            root.row-clicked();
                        }
                        root.drag-armed = false;
                    }
                }
                moved => {
                    if (!self.pressed || root.layer-row.paper || root.renaming) {
                        return;
                    }
                    if (Math.abs((self.mouse-x - root.press-x) / 1px) + Math.abs((self.mouse-y - root.press-y) / 1px) < 5) {
                        return;
                    }
                    root.drag-armed = true;
                    root.hover-leave();
                    root.drag-moved(self.absolute-position.y + self.mouse-y);
                }
                double-clicked => {
                    if (root.layer-row.paper || root.drag-armed) {
                        return;
                    }
                    root.rename-draft = root.layer-row.name;
                    root.renaming = true;
                    root.hover-leave();
                }

                HorizontalLayout {
                    spacing: Tokens.space-sm;

                    if root.layer-row.clipped: Rectangle {
                        width: 2px;
                        height: Tokens.layer-thumb-height * 0.55;
                        border-radius: 1px;
                        background: Theme.text-muted;
                    }

                    LayerThumb {
                        thumb: root.layer-row.thumb;
                    }

                    if root.renaming: CalmField {
                        horizontal-stretch: 1;
                        height: Tokens.control-height;
                        radius: Tokens.radius-sm;
                        pad: Tokens.space-sm;
                        text-size: Tokens.body-size;
                        auto-focus: true;
                        text <=> root.rename-draft;
                        accepted(_) => {
                            root.commit-rename();
                        }
                        cancelled => {
                            root.renaming = false;
                        }
                        focus-lost => {
                            root.commit-rename();
                        }
                    }

                    if !root.renaming: CalmBody {
                        text: root.layer-row.name;
                        strong: root.layer-row.active;
                        horizontal-stretch: 1;
                        opacity: root.layer-row.visible ? 1.0 : 0.45;
                        overflow: elide;
                    }
                }
            }

            trash-hot := CalmPointer {
                width: Tokens.row-icon-size;

                if root.row-hovered && !root.layer-row.locked && !root.drag-armed && !root.renaming: CalmIconButton {
                    icon: root.icon-trash;
                    tint: Theme.danger;
                    tip: root.delete-tip;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.delete-layer();
                    }
                }
            }
        }
    }

    Rectangle {
        width: Tokens.row-icon-size;

        CalmIconButton {
            icon: root.layer-row.visible ? root.icon-eye-open : root.icon-eye-closed;
            tint: root.layer-row.visible ? Theme.text-muted : Theme.desk-grid;
            tip: root.visibility-tip;
            y: (parent.height - self.height) / 2;
            clicked => {
                root.toggle-visible();
            }
        }
    }

    Rectangle {
        width: Tokens.row-icon-size;

        more-btn := CalmIconButton {
            icon: root.icon-more;
            tip: root.settings-tip;
            y: (parent.height - self.height) / 2;
            clicked => {
                root.open-settings(
                    more-btn.absolute-position.x / 1px,
                    (more-btn.absolute-position.y + more-btn.height) / 1px,
                );
            }
        }
    }
}

component BoundsField inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;

    callback committed(string);

    spacing: Tokens.space-sm;
    horizontal-stretch: 1;

    CalmLabel {
        label: root.label;
        width: 12px;
    }

    field := CalmField {
        horizontal-stretch: 1;
        height: Tokens.control-height;
        radius: Tokens.radius-sm;
        pad: Tokens.space-sm;
        text-size: Tokens.body-size;
        mono: true;
        text <=> root.value;
        accepted(text) => {
            root.committed(text);
        }
    }

    property <bool> field-focused: field.focused;
    changed field-focused => {
        if (!root.field-focused) {
            root.committed(root.value);
        }
    }
}

export component LayersPanel inherits CalmIsland {
    in property <string> title-text;
    in property <string> add-tip;
    in property <string> bounds-label;
    in property <string> bounds-x-label;
    in property <string> bounds-y-label;
    in property <string> width-label;
    in property <string> height-label;
    in-out property <string> doc-width-text;
    in-out property <string> doc-height-text;
    in-out property <string> layer-x-text;
    in-out property <string> layer-y-text;
    in-out property <string> layer-w-text;
    in-out property <string> layer-h-text;
    in property <string> visibility-tip;
    in property <string> settings-tip;
    in property <string> delete-tip;
    in property <[LayerRow]> layers;

    callback add-layer();
    callback pick-layer(int);
    callback toggle-layer-visible(int);
    callback open-layer-settings(int, float, float);
    callback delete-layer(int);
    callback rename-layer(int, string);
    callback reorder-layer(int, int);
    callback hover-layer(int, length);
    callback clear-layer-hover();
    callback commit-layer-bounds(string, string, string, string);
    callback commit-canvas-size(string, string);

    private property <image> icon-eye-open: @image-url("eye-open.svg");
    private property <image> icon-eye-closed: @image-url("eye-closed.svg");
    private property <image> icon-more: @image-url("more.svg");
    private property <image> icon-trash: @image-url("trash.svg");
    private property <image> icon-plus: @image-url("plus.svg");
    private property <int> drag-from: -1;
    private property <int> drop-row: -1;
    private property <length> row-stride: Tokens.layer-thumb-height + Tokens.space-xs * 2 + Tokens.space-sm;

    function row-at(abs-y: length) -> int {
        if (root.layers.length <= 0) {
            return 0;
        }
        let local = (abs-y - list-scroll.absolute-position.y - list-scroll.viewport-y) / 1px;
        let stride = root.row-stride / 1px;
        return Math.max(0, Math.min(root.layers.length - 1, Math.floor(local / stride)));
    }

    width: Tokens.layers-panel-width;
    island-padding: Tokens.space-sm;
    clip: true;

    VerticalLayout {
        padding: root.island-padding;
        spacing: Tokens.space-sm;

        HorizontalLayout {
            CalmLabel {
                label: root.title-text;
                horizontal-stretch: 1;
            }

            CalmIconButton {
                icon: root.icon-plus;
                tip: root.add-tip;
                clicked => {
                    root.add-layer();
                }
            }
        }

        list-scroll := CalmScrollView {
            vertical-stretch: 1;
            min-height: 96px;

            VerticalLayout {
                padding: Tokens.space-xs;
                spacing: Tokens.space-sm;
                alignment: start;

                for layer[i] in root.layers: LayerListRow {
                    layer-row: layer;
                    icon-eye-open: root.icon-eye-open;
                    icon-eye-closed: root.icon-eye-closed;
                    icon-more: root.icon-more;
                    icon-trash: root.icon-trash;
                    visibility-tip: root.visibility-tip;
                    settings-tip: root.settings-tip;
                    delete-tip: root.delete-tip;
                    dragging: root.drag-from == i;
                    drop-target: root.drag-from >= 0 && root.drop-row == i && root.drag-from != i && !layer.paper;
                    row-clicked => {
                        root.pick-layer(layer.index);
                    }
                    toggle-visible => {
                        root.toggle-layer-visible(layer.index);
                    }
                    open-settings(anchor-x, anchor-y) => {
                        root.open-layer-settings(layer.index, anchor-x, anchor-y);
                    }
                    delete-layer => {
                        root.delete-layer(layer.index);
                    }
                    rename-layer(name) => {
                        root.rename-layer(layer.index, name);
                    }
                    hover-enter(y) => {
                        if (root.drag-from < 0) {
                            root.hover-layer(layer.index, y - root.absolute-position.y);
                        }
                    }
                    hover-leave => {
                        if (root.drag-from < 0) {
                            root.clear-layer-hover();
                        }
                    }
                    drag-moved(abs-y) => {
                        root.drag-from = i;
                        root.drop-row = root.row-at(abs-y);
                    }
                    drag-finished => {
                        if (root.drag-from >= 0 && root.drop-row >= 0 && root.drag-from != root.drop-row) {
                            root.reorder-layer(root.drag-from, root.drop-row);
                        }
                        root.drag-from = -1;
                        root.drop-row = -1;
                    }
                }
            }
        }

        CalmDivider { }

        CalmLabel {
            label: root.bounds-label;
        }

        HorizontalLayout {
            spacing: Tokens.space-sm;

            BoundsField {
                label: root.bounds-x-label;
                value <=> root.layer-x-text;
                committed(_) => {
                    root.commit-layer-bounds(root.layer-x-text, root.layer-y-text, root.layer-w-text, root.layer-h-text);
                }
            }

            BoundsField {
                label: root.bounds-y-label;
                value <=> root.layer-y-text;
                committed(_) => {
                    root.commit-layer-bounds(root.layer-x-text, root.layer-y-text, root.layer-w-text, root.layer-h-text);
                }
            }
        }

        HorizontalLayout {
            spacing: Tokens.space-sm;

            BoundsField {
                label: root.width-label;
                value <=> root.layer-w-text;
                committed(_) => {
                    root.commit-layer-bounds(root.layer-x-text, root.layer-y-text, root.layer-w-text, root.layer-h-text);
                }
            }

            BoundsField {
                label: root.height-label;
                value <=> root.layer-h-text;
                committed(_) => {
                    root.commit-layer-bounds(root.layer-x-text, root.layer-y-text, root.layer-w-text, root.layer-h-text);
                }
            }
        }

        CalmDivider { }

        HorizontalLayout {
            spacing: Tokens.space-sm;

            BoundsField {
                label: root.width-label;
                value <=> root.doc-width-text;
                committed(_) => {
                    root.commit-canvas-size(root.doc-width-text, root.doc-height-text);
                }
            }

            BoundsField {
                label: root.height-label;
                value <=> root.doc-height-text;
                committed(_) => {
                    root.commit-canvas-size(root.doc-width-text, root.doc-height-text);
                }
            }
        }
    }
}

export component LayerHoverCard inherits Rectangle {
    in property <string> layer-name;
    in property <image> preview;

    width: Tokens.hover-card-width;
    background: Theme.surface;
    border-radius: Tokens.radius-md;
    border-width: 1px;
    border-color: Theme.island-border;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;

    VerticalLayout {
        padding: Tokens.space-md;
        spacing: Tokens.space-sm;

        CalmBody {
            text: root.layer-name;
            strong: true;
            overflow: elide;
        }

        Rectangle {
            height: Tokens.hover-card-preview-height;
            border-radius: Tokens.radius-sm;
            background: Theme.surface-hover;
            clip: true;

            Image {
                source: root.preview;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }
    }
}
