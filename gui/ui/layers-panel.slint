import { LayerChrome } from "layer-chrome.slint";
import { LayerListChrome } from "layer-list-chrome.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmScrollView } from "calm/CalmScrollView.slint";
import { CalmIsland } from "calm/CalmIsland.slint";
import { CalmDivider } from "calm/CalmDivider.slint";
import { CalmIconButton } from "calm/CalmToolButton.slint";
import { CalmLabel } from "calm/CalmText.slint";
import { LayerListRow } from "layer-list-row.slint";
import { LayerBoundsFields } from "layer-bounds-fields.slint";

export component LayersPanel inherits CalmIsland {
    private property <image> icon-eye-open: @image-url("eye-open.svg");
    private property <image> icon-eye-closed: @image-url("eye-closed.svg");
    private property <image> icon-more: @image-url("more.svg");
    private property <image> icon-trash: @image-url("trash.svg");
    private property <image> icon-plus: @image-url("plus.svg");
    private property <image> icon-clip: @image-url("clip.svg");
    private property <image> icon-mask: @image-url("mask.svg");
    private property <int> drag-from: -1;
    private property <int> drop-row: -1;
    private property <length> row-stride: Tokens.layer-thumb-height + Tokens.space-xs * 2 + Tokens.space-sm;

    function row-at(abs-y: length) -> int {
        if (LayerListChrome.layers.length <= 0) {
            return 0;
        }
        let local = (abs-y - list-scroll.absolute-position.y - list-scroll.viewport-y) / 1px;
        let stride = root.row-stride / 1px;
        return Math.max(0, Math.min(LayerListChrome.layers.length - 1, Math.floor(local / stride)));
    }

    width: Tokens.layers-panel-width;
    island-padding: Tokens.space-sm;
    clip: true;

    VerticalLayout {
        padding: root.island-padding;
        spacing: Tokens.space-sm;

        HorizontalLayout {
            CalmLabel {
                label: LayerListChrome.title-text;
                horizontal-stretch: 1;
            }

            CalmIconButton {
                icon: root.icon-plus;
                tip: LayerListChrome.add-tip;
                clicked => {
                    LayerListChrome.add-layer();
                }
            }
        }

        list-scroll := CalmScrollView {
            vertical-stretch: 1;
            min-height: 96px;

            VerticalLayout {
                padding: Tokens.space-xs;
                spacing: Tokens.space-sm;
                alignment: start;

                for layer[i] in LayerListChrome.layers: LayerListRow {
                    layer-row: layer;
                    icon-eye-open: root.icon-eye-open;
                    icon-eye-closed: root.icon-eye-closed;
                    icon-more: root.icon-more;
                    icon-trash: root.icon-trash;
                    icon-clip: root.icon-clip;
                    icon-mask: root.icon-mask;
                    visibility-tip: LayerListChrome.visibility-tip;
                    settings-tip: LayerListChrome.settings-tip;
                    delete-tip: LayerListChrome.delete-tip;
                    dragging: root.drag-from == i;
                    drop-target: root.drag-from >= 0 && root.drop-row == i && root.drag-from != i && !layer.paper;
                    row-clicked(extend) => {
                        if (extend) {
                            LayerChrome.toggle-layer-selected(layer.index);
                        } else {
                            LayerListChrome.pick-layer(layer.index);
                        }
                    }
                    toggle-visible => {
                        LayerListChrome.toggle-visible(layer.index);
                    }
                    open-settings(anchor-x, anchor-y) => {
                        LayerListChrome.open-settings(layer.index, anchor-x, anchor-y);
                    }
                    delete-layer => {
                        LayerListChrome.delete-layer(layer.index);
                    }
                    rename-layer(name) => {
                        LayerListChrome.rename-layer(layer.index, name);
                    }
                    hover-enter => {
                        if (root.drag-from < 0) {
                            LayerListChrome.hover-layer(layer.index);
                        }
                    }
                    hover-leave => {
                        if (root.drag-from < 0) {
                            LayerListChrome.clear-hover();
                        }
                    }
                    drag-moved(abs-y) => {
                        root.drag-from = i;
                        root.drop-row = root.row-at(abs-y);
                    }
                    drag-finished => {
                        if (root.drag-from >= 0 && root.drop-row >= 0 && root.drag-from != root.drop-row) {
                            LayerListChrome.reorder-layer(root.drag-from, root.drop-row);
                        }
                        root.drag-from = -1;
                        root.drop-row = -1;
                    }
                }
            }
        }

        CalmDivider { }

        LayerBoundsFields { }
    }
}
