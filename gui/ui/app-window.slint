import { Landing } from "landing.slint";
import { Editor } from "editor.slint";
import { RecentRow, PresetRow, LayerRow, ToolEntry, BrushEntry, GuideRow, ProjectTabRow } from "models.slint";
import { RulerTickRow } from "ruler.slint";
import { Titlebar } from "titlebar.slint";
import { SettingsModal } from "settings-modal.slint";
import { NewProjectModal } from "new-project-modal.slint";
import { ToastBanner } from "toast-banner.slint";
import { LayerSettingsModal } from "layer-settings-modal.slint";
import { GuidesCard } from "guides-card.slint";
import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmTip, Tip } from "calm/CalmTip.slint";
import { ToolChrome } from "tool-chrome.slint";
import { LayerChrome } from "layer-chrome.slint";
import { SmartMenu, SmartMenuOverlay } from "smart-menu.slint";

export { Theme, Tokens, RecentRow, PresetRow, LayerRow, ToolEntry, BrushEntry, GuideRow, RulerTickRow, ToolChrome, LayerChrome, Tip, SmartMenu, ProjectTabRow }

export component AppWindow inherits Window {
    in-out property <bool> editor-open: false;
    in-out property <bool> loading: false;
    in property <float> loading-doc-width: 1;
    in property <float> loading-doc-height: 1;
    in-out property <bool> settings-open: false;
    in-out property <bool> new-project-open: false;
    in-out property <bool> layers-open: true;
    in-out property <bool> layer-settings-open: false;
    in-out property <bool> guides-open: false;

    changed editor-open => {
        if (!root.editor-open) {
            SmartMenu.open = false;
            Tip.open = false;
            root.guides-open = false;
        }
    }

    callback create-project();
    callback open-recent(string);
    callback delete-recent(string);
    callback clear-recents();
    callback preset-size(int, int);
    callback paste-artwork-clicked();
    callback app-icon-clicked();
    callback back-to-landing();
    callback switch-project-tab(string);
    callback close-project-tab(string);
    callback create-from-modal();

    callback pointer-pressed(float, float, bool, bool, bool, bool);
    callback pointer-moved(float, float);
    callback pointer-released(float, float);
    callback pointer-enter();
    callback pointer-exit();
    callback scrolled(float, float, float, float, bool, bool);
    callback pinch-started();
    callback pinch-updated(float, float, float);
    callback pinch-ended();

    callback pick-tool(int);
    callback pick-brush(int);
    callback brush-size-changed(float);
    callback brush-size-committed(string);
    callback ink-opacity-changed(float);
    callback blur-changed(float);
    callback hardness-changed(float);
    callback tolerance-changed(float);
    callback eyedropper-changed(float);
    callback fill-toggled();
    callback stroke-toggled();
    callback vector-toggled();
    callback aligned-toggled();
    callback transform-toggled();
    callback crop-aspect-changed(int);
    callback crop-overlay-changed(int);
    callback commit-crop();
    callback cancel-crop();
    callback zoom-changed(float);
    callback step-zoom(bool);
    callback fit-zoom();
    callback toggle-layers();
    callback menu-fit-view();
    callback menu-fullscreen();
    callback menu-new-project();
    callback menu-settings();
    callback menu-undo();
    callback menu-redo();
    callback add-layer();
    callback pick-layer(int);
    callback toggle-layer-visible(int);
    callback open-layer-settings(int);
    callback delete-layer(int);
    callback hover-layer(int, float);
    callback clear-layer-hover();
    callback commit-layer-bounds(string, string, string, string);
    callback commit-canvas-size(string, string);
    callback run-upscale();
    callback run-smart-matte();
    callback run-seam-carve();
    callback export-png();
    callback export-jpeg();
    callback export-webp();
    callback export-avif();
    callback export-heic();
    callback export-psd();
    callback export-svg();
    callback export-pdf();
    callback layer-settings-dismissed();
    callback layer-settings-toggle-visibility();
    callback layer-settings-toggle-lock();
    callback layer-settings-opacity-changed(float);
    callback layer-settings-blend-changed(int);
    callback layer-settings-filter-changed(int, float);
    callback layer-settings-reset-filters();
    callback layer-settings-rename(string);
    callback layer-settings-toggle-clip();
    callback layer-settings-flatten-clip();
    callback layer-settings-merge-down();
    callback layer-settings-reset-transform();
    callback layer-settings-move-up();
    callback layer-settings-move-down();
    callback layer-settings-rasterize();
    callback layer-settings-export-layer();
    callback layer-settings-duplicate();
    callback layer-settings-delete();
    callback titlebar-drag();
    callback titlebar-zoom();

    callback select-color-swatch(int);
    callback color-sb-changed(float, float);
    callback color-hue-changed(float);
    callback color-hex-changed(string);

    callback guide-pressed(bool, float, float);
    callback guide-moved(float, float);
    callback guide-released();
    callback open-guides();
    callback guides-dismissed();
    callback add-guide();
    callback remove-guide(int);
    callback clear-guides();
    callback set-guide-axis(int, bool);
    callback set-guide-offset(int, string);
    callback set-guide-color(int, int);

    callback shell-key-pressed(string, bool, bool, bool, bool);
    callback shell-key-released(string, bool, bool, bool, bool);

    callback settings-dismissed();
    callback new-project-dismissed();
    callback set-theme-light();
    callback set-theme-dark();
    callback set-language-en();
    callback toast-dismissed();

    in-out property <string> project-name;
    in-out property <string> width-text;
    in-out property <string> height-text;
    in property <[ProjectTabRow]> project-tabs;
    in property <string> close-project-tab-tip;

    in-out property <int> active-tool;
    in property <[ToolEntry]> tools;
    in property <string> active-tool-label;
    in-out property <float> zoom-unit;
    in property <string> zoom-text;
    in property <bool> is-fit;
    in-out property <string> doc-width-text;
    in-out property <string> doc-height-text;
    in-out property <string> layer-x-text;
    in-out property <string> layer-y-text;
    in-out property <string> layer-w-text;
    in-out property <string> layer-h-text;
    in property <string> bounds-label;
    in property <string> bounds-x-label;
    in property <string> bounds-y-label;

    in property <bool> tools-busy;
    in property <string> tools-menu-title;
    in property <string> upscale-label;
    in property <string> smart-matte-label;
    in property <string> seam-carve-label;
    in property <bool> can-upscale;
    in property <bool> can-smart-matte;
    in property <bool> can-seam-carve;

    in property <bool> hover-preview-visible;
    in property <string> hover-preview-name;
    in property <image> hover-preview-image;
    in property <float> hover-preview-y;

    in property <string> layer-settings-label;
    in property <string> layer-settings-name;
    in property <string> back-to-landing-tip;
    out property <length> board-x: editor.board-x;
    out property <length> board-y: editor.board-y;
    out property <length> board-width: editor.board-width;
    out property <length> board-height: editor.board-height;
    in property <string> width-short-label;
    in property <string> height-short-label;
    in property <bool> layer-settings-visible;
    in property <bool> layer-settings-locked;
    in property <bool> layer-settings-can-delete;
    in property <image> layer-settings-preview;
    in-out property <float> layer-settings-opacity;
    in property <string> layer-settings-opacity-text;
    in property <string> layer-lock-label;
    in property <string> opacity-label;
    in property <string> layer-visibility-label;
    in property <string> layer-export-label;
    in property <string> layer-duplicate-label;
    in property <string> layer-delete-label;

    in property <string> color-label;
    in property <brush> color-swatch0;
    in property <brush> color-swatch1;
    in property <brush> color-swatch2;
    in property <int> active-color-swatch;
    in property <color> color-hue-brush;
    in property <string> primary-color-label;
    in property <string> secondary-color-label;
    in property <string> tertiary-color-label;
    in-out property <float> color-sb-x;
    in-out property <float> color-sb-y;
    in-out property <float> color-hue-x;
    in-out property <string> color-hex-text;

    in property <bool> theme-is-dark;
    in property <bool> language-is-en;
    in property <string> language-name;
    in property <string> memory-value;
    in property <string> version-value;
    in property <bool> toast-visible;
    in property <string> toast-text;
    in property <bool> toast-is-error;

    in property <image> app-icon;
    in property <string> brand-text;
    in property <string> tagline-text;
    in property <string> project-name-label;
    in property <string> resolution-label;
    in property <string> create-label;
    in property <string> presets-label;
    in property <string> recents-label;
    in property <string> clear-all-label;
    in property <string> no-recents-label;
    in property <string> delete-project-label;
    in property <string> paste-artwork-title;
    in property <string> paste-artwork-hint;
    in property <string> artwork-formats;
    in property <string> settings-title;
    in property <string> theme-label;
    in property <string> theme-light-label;
    in property <string> theme-dark-label;
    in property <string> language-label;
    in property <string> memory-label;
    in property <string> version-label;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <[LayerRow]> layers;

    in property <string> file-menu-title;
    in property <string> edit-menu-title;
    in property <string> board-menu-title;
    in property <string> new-project-menu-title;
    in property <string> undo-menu-title;
    in property <string> redo-menu-title;
    in property <string> fit-view-menu-title;
    in property <string> toggle-layers-menu-title;
    in property <string> fullscreen-menu-title;
    in property <string> layers-title;
    in property <string> add-layer-label;
    in property <string> zoom-in-label;
    in property <string> zoom-out-label;
    in property <string> fit-view-label;
    in property <string> export-menu-title;
    in property <string> export-png-title;
    in property <string> export-jpeg-title;
    in property <string> export-webp-title;
    in property <string> export-avif-title;
    in property <string> export-heic-title;
    in property <string> export-psd-title;
    in property <string> export-svg-title;
    in property <string> export-pdf-title;

    in property <[PresetRow]> presets;
    in property <[RecentRow]> recents;
    in property <[RulerTickRow]> ruler-ticks-x;
    in property <[RulerTickRow]> ruler-ticks-y;
    in property <string> guides-tip;
    in property <string> guides-title;
    in property <string> guides-hint;
    in property <string> no-guides-label;
    in property <string> add-guide-label;
    in property <string> guides-full-label;
    in property <string> guide-top-label;
    in property <string> guide-left-label;
    in property <string> delete-guide-tip;
    in property <string> clear-guides-label;
    in property <[GuideRow]> guides;
    in property <[color]> guide-palette;
    in property <bool> can-add-guide;
    in-out property <bool> add-guide-horizontal;
    in-out property <string> add-guide-offset;
    in property <bool> guide-readout-visible;
    in property <bool> guide-readout-horizontal;
    in property <string> guide-readout-text;
    in property <float> guide-readout-screen;

    init => {
        focus-scope.focus();
    }

    title: "";
    preferred-width: 960px;
    preferred-height: 520px;
    min-width: Tokens.main-min-width;
    min-height: Tokens.main-min-height;
    background: Theme.bg;

    MenuBar {
        Menu {
            title: root.file-menu-title;
            MenuItem {
                title: root.new-project-menu-title;
                enabled: root.editor-open;
                activated => {
                    root.menu-new-project();
                }
            }
            Menu {
                title: root.export-menu-title;
                enabled: root.editor-open;
                MenuItem {
                    title: root.export-png-title;
                    activated => {
                        root.export-png();
                    }
                }
                MenuItem {
                    title: root.export-jpeg-title;
                    activated => {
                        root.export-jpeg();
                    }
                }
                MenuItem {
                    title: root.export-webp-title;
                    activated => {
                        root.export-webp();
                    }
                }
                MenuItem {
                    title: root.export-avif-title;
                    activated => {
                        root.export-avif();
                    }
                }
                MenuItem {
                    title: root.export-heic-title;
                    activated => {
                        root.export-heic();
                    }
                }
                MenuItem {
                    title: root.export-psd-title;
                    activated => {
                        root.export-psd();
                    }
                }
                MenuItem {
                    title: root.export-svg-title;
                    activated => {
                        root.export-svg();
                    }
                }
                MenuItem {
                    title: root.export-pdf-title;
                    activated => {
                        root.export-pdf();
                    }
                }
            }
            MenuItem {
                title: root.settings-title;
                activated => {
                    root.menu-settings();
                }
            }
        }
        Menu {
            title: root.edit-menu-title;
            MenuItem {
                title: root.undo-menu-title;
                enabled: root.editor-open && root.can-undo;
                activated => {
                    root.menu-undo();
                }
            }
            MenuItem {
                title: root.redo-menu-title;
                enabled: root.editor-open && root.can-redo;
                activated => {
                    root.menu-redo();
                }
            }
        }
        Menu {
            title: root.board-menu-title;
            MenuItem {
                title: root.fit-view-menu-title;
                enabled: root.editor-open;
                activated => {
                    root.menu-fit-view();
                }
            }
            MenuItem {
                title: root.toggle-layers-menu-title;
                enabled: root.editor-open;
                checkable: true;
                checked: root.layers-open;
                activated => {
                    root.toggle-layers();
                }
            }
            MenuItem {
                title: root.fullscreen-menu-title;
                activated => {
                    root.menu-fullscreen();
                }
            }
        }
    }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            root.shell-key-pressed(
                event.text,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
                event.modifiers.alt,
            );
            accept;
        }

        key-released(event) => {
            root.shell-key-released(
                event.text,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
                event.modifiers.alt,
            );
            accept;
        }

        Rectangle {
            width: 100%;
            height: 100%;

        Landing {
            width: 100%;
            height: 100%;
            visible: !root.editor-open;
            brand-text: root.brand-text;
            tagline-text: root.tagline-text;
            project-name-label: root.project-name-label;
            resolution-label: root.resolution-label;
            create-label: root.create-label;
            presets-label: root.presets-label;
            recents-label: root.recents-label;
            clear-all-label: root.clear-all-label;
            no-recents-label: root.no-recents-label;
            delete-project-label: root.delete-project-label;
            paste-artwork-title: root.paste-artwork-title;
            paste-artwork-hint: root.paste-artwork-hint;
            artwork-formats: root.artwork-formats;
            app-icon: root.app-icon;
            project-name <=> root.project-name;
            width-text <=> root.width-text;
            height-text <=> root.height-text;
            presets: root.presets;
            recents: root.recents;
            create-clicked => {
                root.create-project();
            }
            preset-clicked(width, height) => {
                root.preset-size(width, height);
                root.create-project();
            }
            recent-clicked(id) => {
                root.open-recent(id);
            }
            delete-recent(id) => {
                root.delete-recent(id);
            }
            clear-all-clicked => {
                root.clear-recents();
            }
            paste-artwork-clicked => {
                root.paste-artwork-clicked();
            }
            app-icon-clicked => {
                root.app-icon-clicked();
            }
        }

        editor := Editor {
            width: 100%;
            height: 100%;
            visible: root.editor-open;
            loading: root.loading;
            loading-doc-width: root.loading-doc-width;
            loading-doc-height: root.loading-doc-height;
            ruler-ticks-x: root.ruler-ticks-x;
            ruler-ticks-y: root.ruler-ticks-y;
            guides-tip: root.guides-tip;
            guide-readout-visible: root.guide-readout-visible;
            guide-readout-horizontal: root.guide-readout-horizontal;
            guide-readout-text: root.guide-readout-text;
            guide-readout-screen: root.guide-readout-screen;
            open-guides => {
                root.open-guides();
            }
            guide-pressed(horizontal, x, y) => {
                root.guide-pressed(horizontal, x, y);
            }
            guide-moved(x, y) => {
                root.guide-moved(x, y);
            }
            guide-released => {
                root.guide-released();
            }
            layers-open: root.layers-open;
            layers-title: root.layers-title;
            add-layer-tip: root.add-layer-label;
            layer-visibility-tip: root.layer-visibility-label;
            layer-settings-tip: root.layer-settings-label;
            delete-layer-tip: root.layer-delete-label;
            width-label: root.width-short-label;
            height-label: root.height-short-label;
            doc-width-text <=> root.doc-width-text;
            doc-height-text <=> root.doc-height-text;
            layers: root.layers;
            hover-preview-visible: root.hover-preview-visible;
            hover-preview-name: root.hover-preview-name;
            hover-preview-image: root.hover-preview-image;
            hover-preview-y: root.hover-preview-y;
            active-tool: root.active-tool;
            tools: root.tools;
            active-tool-label: root.active-tool-label;
            zoom-unit <=> root.zoom-unit;
            zoom-text: root.zoom-text;
            is-fit: root.is-fit;
            zoom-in-tip: root.zoom-in-label;
            zoom-out-tip: root.zoom-out-label;
            fit-tip: root.fit-view-label;
            tools-busy: root.tools-busy;
            tools-menu-title: root.tools-menu-title;
            upscale-label: root.upscale-label;
            smart-matte-label: root.smart-matte-label;
            seam-carve-label: root.seam-carve-label;
            can-upscale: root.can-upscale;
            can-smart-matte: root.can-smart-matte;
            can-seam-carve: root.can-seam-carve;
            color-label: root.color-label;
            color-swatch0: root.color-swatch0;
            color-swatch1: root.color-swatch1;
            color-swatch2: root.color-swatch2;
            active-color-swatch: root.active-color-swatch;
            color-hue-brush: root.color-hue-brush;
            primary-color-label: root.primary-color-label;
            secondary-color-label: root.secondary-color-label;
            tertiary-color-label: root.tertiary-color-label;
            color-sb-x <=> root.color-sb-x;
            color-sb-y <=> root.color-sb-y;
            color-hue-x <=> root.color-hue-x;
            color-hex-text <=> root.color-hex-text;
            bounds-label: root.bounds-label;
            bounds-x-label: root.bounds-x-label;
            bounds-y-label: root.bounds-y-label;
            layer-x-text <=> root.layer-x-text;
            layer-y-text <=> root.layer-y-text;
            layer-w-text <=> root.layer-w-text;
            layer-h-text <=> root.layer-h-text;
            pick-tool(id) => {
                root.pick-tool(id);
            }
            pick-brush(id) => {
                root.pick-brush(id);
            }
            brush-size-changed(v) => {
                root.brush-size-changed(v);
            }
            brush-size-committed(text) => {
                root.brush-size-committed(text);
            }
            ink-opacity-changed(v) => {
                root.ink-opacity-changed(v);
            }
            blur-changed(v) => {
                root.blur-changed(v);
            }
            hardness-changed(v) => {
                root.hardness-changed(v);
            }
            tolerance-changed(v) => {
                root.tolerance-changed(v);
            }
            eyedropper-changed(v) => {
                root.eyedropper-changed(v);
            }
            fill-toggled => {
                root.fill-toggled();
            }
            stroke-toggled => {
                root.stroke-toggled();
            }
            vector-toggled => {
                root.vector-toggled();
            }
            aligned-toggled => {
                root.aligned-toggled();
            }
            transform-toggled => {
                root.transform-toggled();
            }
            crop-aspect-changed(index) => {
                root.crop-aspect-changed(index);
            }
            crop-overlay-changed(index) => {
                root.crop-overlay-changed(index);
            }
            commit-crop => {
                root.commit-crop();
            }
            cancel-crop => {
                root.cancel-crop();
            }
            zoom-changed(v) => {
                root.zoom-changed(v);
            }
            step-zoom(zoom-in) => {
                root.step-zoom(zoom-in);
            }
            fit-zoom => {
                root.fit-zoom();
            }
            add-layer => {
                root.add-layer();
            }
            pick-layer(index) => {
                root.pick-layer(index);
            }
            toggle-layer-visible(index) => {
                root.toggle-layer-visible(index);
            }
            open-layer-settings(index) => {
                root.open-layer-settings(index);
            }
            delete-layer(index) => {
                root.delete-layer(index);
            }
            hover-layer(index, y) => {
                root.hover-layer(index, y);
            }
            clear-layer-hover => {
                root.clear-layer-hover();
            }
            commit-layer-bounds(x, y, w, h) => {
                root.commit-layer-bounds(x, y, w, h);
            }
            commit-canvas-size(w, h) => {
                root.commit-canvas-size(w, h);
            }
            run-upscale => {
                root.run-upscale();
            }
            run-smart-matte => {
                root.run-smart-matte();
            }
            run-seam-carve => {
                root.run-seam-carve();
            }
            select-color-swatch(i) => {
                root.select-color-swatch(i);
            }
            color-sb-changed(x, y) => {
                root.color-sb-changed(x, y);
            }
            color-hue-changed(x) => {
                root.color-hue-changed(x);
            }
            color-hex-changed(text) => {
                root.color-hex-changed(text);
            }
            pointer-pressed(x, y, middle, meta, alt, shift) => {
                root.pointer-pressed(x, y, middle, meta, alt, shift);
            }
            pointer-moved(x, y) => {
                root.pointer-moved(x, y);
            }
            pointer-released(x, y) => {
                root.pointer-released(x, y);
            }
            pointer-enter => {
                root.pointer-enter();
            }
            pointer-exit => {
                root.pointer-exit();
            }
            scrolled(x, y, dx, dy, alt, meta) => {
                root.scrolled(x, y, dx, dy, alt, meta);
            }
            pinch-started => {
                root.pinch-started();
            }
            pinch-updated(x, y, scale) => {
                root.pinch-updated(x, y, scale);
            }
            pinch-ended => {
                root.pinch-ended();
            }
        }
        }

        Titlebar {
            z: 10;
            y: 0;
            width: 100%;
            editor-open: root.editor-open;
            project-tabs: root.project-tabs;
            new-project-tip: root.new-project-menu-title;
            close-tip: root.close-project-tab-tip;
            switch-project-tab(id) => {
                root.switch-project-tab(id);
            }
            close-project-tab(id) => {
                root.close-project-tab(id);
            }
            new-project => {
                root.menu-new-project();
            }
            drag => {
                root.titlebar-drag();
            }
            zoom => {
                root.titlebar-zoom();
            }
        }

        SettingsModal {
            z: 20;
            open <=> root.settings-open;
            title-text: root.settings-title;
            theme-label: root.theme-label;
            theme-light-label: root.theme-light-label;
            theme-dark-label: root.theme-dark-label;
            language-label: root.language-label;
            language-name: root.language-name;
            memory-label: root.memory-label;
            memory-value: root.memory-value;
            version-label: root.version-label;
            version-value: root.version-value;
            theme-is-dark: root.theme-is-dark;
            language-is-en: root.language-is-en;
            dismissed => {
                root.settings-dismissed();
            }
            set-theme-light => {
                root.set-theme-light();
            }
            set-theme-dark => {
                root.set-theme-dark();
            }
            set-language-en => {
                root.set-language-en();
            }
        }

        NewProjectModal {
            z: 20;
            open <=> root.new-project-open;
            brand-text: root.brand-text;
            tagline-text: root.tagline-text;
            project-name-label: root.project-name-label;
            resolution-label: root.resolution-label;
            create-label: root.create-label;
            presets-label: root.presets-label;
            recents-label: root.recents-label;
            clear-all-label: root.clear-all-label;
            no-recents-label: root.no-recents-label;
            delete-project-label: root.delete-project-label;
            paste-artwork-title: root.paste-artwork-title;
            paste-artwork-hint: root.paste-artwork-hint;
            artwork-formats: root.artwork-formats;
            app-icon: root.app-icon;
            project-name <=> root.project-name;
            width-text <=> root.width-text;
            height-text <=> root.height-text;
            presets: root.presets;
            recents: root.recents;
            dismissed => {
                root.new-project-dismissed();
            }
            create-clicked => {
                root.create-from-modal();
            }
            preset-clicked(width, height) => {
                root.preset-size(width, height);
                root.create-from-modal();
            }
            recent-clicked(id) => {
                root.open-recent(id);
            }
            delete-recent(id) => {
                root.delete-recent(id);
            }
            clear-all-clicked => {
                root.clear-recents();
            }
            paste-artwork-clicked => {
                root.paste-artwork-clicked();
            }
            app-icon-clicked => {
                root.app-icon-clicked();
            }
        }

        GuidesCard {
            z: 20;
            open <=> root.guides-open;
            title-text: root.guides-title;
            hint-text: root.guides-hint;
            empty-text: root.no-guides-label;
            add-label: root.add-guide-label;
            full-text: root.guides-full-label;
            top-label: root.guide-top-label;
            left-label: root.guide-left-label;
            delete-tip: root.delete-guide-tip;
            clear-label: root.clear-guides-label;
            guides: root.guides;
            palette: root.guide-palette;
            can-add: root.can-add-guide;
            add-horizontal <=> root.add-guide-horizontal;
            add-offset <=> root.add-guide-offset;
            dismissed => {
                root.guides-dismissed();
            }
            add-guide => {
                root.add-guide();
            }
            remove-guide(index) => {
                root.remove-guide(index);
            }
            clear-guides => {
                root.clear-guides();
            }
            set-axis(index, horizontal) => {
                root.set-guide-axis(index, horizontal);
            }
            set-offset(index, text) => {
                root.set-guide-offset(index, text);
            }
            set-color(index, palette-index) => {
                root.set-guide-color(index, palette-index);
            }
        }

        LayerSettingsModal {
            z: 20;
            open <=> root.layer-settings-open;
            dismissed => {
                root.layer-settings-dismissed();
            }
            toggle-visibility => {
                root.layer-settings-toggle-visibility();
            }
            toggle-lock => {
                root.layer-settings-toggle-lock();
            }
            opacity-changed(v) => {
                root.layer-settings-opacity-changed(v);
            }
            blend-changed(mode) => {
                root.layer-settings-blend-changed(mode);
            }
            filter-changed(kind, value) => {
                root.layer-settings-filter-changed(kind, value);
            }
            reset-filters => {
                root.layer-settings-reset-filters();
            }
            rename-layer(text) => {
                root.layer-settings-rename(text);
            }
            toggle-clip => {
                root.layer-settings-toggle-clip();
            }
            flatten-clip => {
                root.layer-settings-flatten-clip();
            }
            merge-down => {
                root.layer-settings-merge-down();
            }
            reset-transform => {
                root.layer-settings-reset-transform();
            }
            move-up => {
                root.layer-settings-move-up();
            }
            move-down => {
                root.layer-settings-move-down();
            }
            rasterize-layer => {
                root.layer-settings-rasterize();
            }
            export-layer => {
                root.layer-settings-export-layer();
            }
            duplicate-layer => {
                root.layer-settings-duplicate();
            }
            delete-layer => {
                root.layer-settings-delete();
            }
        }

        ToastBanner {
            show: root.toast-visible;
            text: root.toast-text;
            is-error: root.toast-is-error;
            dismiss => {
                root.toast-dismissed();
            }
        }

        if SmartMenu.open && root.editor-open: SmartMenuOverlay {
            upscale-label: root.upscale-label;
            smart-matte-label: root.smart-matte-label;
            seam-carve-label: root.seam-carve-label;
            can-upscale: root.can-upscale && !root.tools-busy;
            can-smart-matte: root.can-smart-matte && !root.tools-busy;
            can-seam-carve: root.can-seam-carve && !root.tools-busy;
            run-upscale => {
                root.run-upscale();
            }
            run-smart-matte => {
                root.run-smart-matte();
            }
            run-seam-carve => {
                root.run-seam-carve();
            }
        }
    }

    tip-delay := Timer {
        interval: 450ms;
        running: Tip.armed && !Tip.open;
        triggered => {
            Tip.open = true;
        }
    }

    CalmTip {
        visible: Tip.open && Tip.text != "";
        x: Tip.leading ? Tip.x - self.width : Tip.x;
        y: Tip.y - self.height / 2;
        tip: Tip.text;
        shortcut: Tip.shortcut;
    }
}
