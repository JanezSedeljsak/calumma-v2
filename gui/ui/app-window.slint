import { Landing } from "landing.slint";
import { Editor } from "editor.slint";
import { RecentRow, PresetRow, LayerRow, ToolEntry, BrushEntry, GuideRow, ProjectTabRow } from "models.slint";
import { RulerTickRow } from "ruler.slint";
import { Titlebar } from "titlebar.slint";
import { SettingsModal } from "settings-modal.slint";
import { NewProjectModal } from "new-project-modal.slint";
import { ToastBanner } from "toast-banner.slint";
import { LayerSettingsModal } from "layer-settings-modal.slint";
import { ProjectSettingsPopover } from "project-settings-popover.slint";
import { GuidesCard } from "guides-card.slint";
import { GuideChrome } from "guide-chrome.slint";
import { ColorChrome } from "color-chrome.slint";
import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmTip, Tip } from "calm/CalmTip.slint";
import { ToolChrome } from "tool-chrome.slint";
import { LayerChrome } from "layer-chrome.slint";
import { LayerListChrome } from "layer-list-chrome.slint";
import { MenuChrome } from "menu-chrome.slint";
import { ProjectChrome } from "project-chrome.slint";
import { SettingsChrome } from "settings-chrome.slint";
import { ZoomChrome } from "zoom-chrome.slint";
import { SelectOption } from "calm/CalmSelect.slint";

export { Theme, Tokens, RecentRow, PresetRow, LayerRow, ToolEntry, BrushEntry, GuideRow, RulerTickRow, ToolChrome, LayerChrome, LayerListChrome, GuideChrome, ColorChrome, MenuChrome, ProjectChrome, SettingsChrome, ZoomChrome, Tip, ProjectTabRow, SelectOption }

export component AppWindow inherits Window {
    in-out property <bool> editor-open: false;
    in-out property <bool> loading: false;
    out property <bool> shell-keys-focused: focus-scope.has-focus;
    in property <length> loading-paper-x;
    in property <length> loading-paper-y;
    in property <length> loading-paper-width;
    in property <length> loading-paper-height;
    in-out property <bool> settings-open: false;
    in-out property <bool> new-project-open: false;
    in-out property <bool> layers-open: true;
    in-out property <bool> layer-settings-open: false;
    in-out property <bool> guides-open: false;
    in-out property <bool> project-settings-open: false;

    changed editor-open => {
        if (!root.editor-open) {
            Tip.open = false;
            root.guides-open = false;
            root.project-settings-open = false;
        }
        root.editor-open-changed(root.editor-open);
    }

    callback editor-open-changed(bool);

    callback pointer-pressed(float, float, bool, bool, bool, bool);
    callback pointer-moved(float, float);
    callback pointer-released(float, float);
    callback pointer-enter();
    callback pointer-exit();
    callback scrolled(float, float, float, float, bool, bool);
    callback pinch-started();
    callback pinch-updated(float, float, float);
    callback pinch-ended();

    callback titlebar-drag();
    callback titlebar-zoom();

    callback shell-key-pressed(string, bool, bool, bool, bool);
    callback shell-key-released(string, bool, bool, bool, bool);

    callback toast-dismissed();

    out property <length> board-x: editor.board-x;
    out property <length> board-y: editor.board-y;
    out property <length> board-width: editor.board-width;
    out property <length> board-height: editor.board-height;
    out property <length> zoom-chrome-x: editor.zoom-chrome-x;
    out property <length> zoom-chrome-y: editor.zoom-chrome-y;
    out property <length> zoom-chrome-width: editor.zoom-chrome-width;
    out property <length> zoom-chrome-height: editor.zoom-chrome-height;
    out property <length> zoom-chrome-radius: editor.zoom-chrome-radius;
    out property <length> hover-chrome-x: editor.hover-chrome-x;
    out property <length> hover-chrome-y: editor.hover-chrome-y;
    out property <length> hover-chrome-width: editor.hover-chrome-width;
    out property <length> hover-chrome-height: editor.hover-chrome-height;
    out property <length> hover-chrome-radius: editor.hover-chrome-radius;
    out property <length> guides-chrome-x: guides-card.card-x;
    out property <length> guides-chrome-y: guides-card.card-y;
    out property <length> guides-chrome-width: guides-card.card-width;
    out property <length> guides-chrome-height: guides-card.card-height;
    out property <length> guides-chrome-radius: guides-card.card-radius;
    out property <length> new-project-chrome-x: new-project-card.card-x;
    out property <length> new-project-chrome-y: new-project-card.card-y;
    out property <length> new-project-chrome-width: new-project-card.card-width;
    out property <length> new-project-chrome-height: new-project-card.card-height;
    out property <length> new-project-chrome-radius: new-project-card.card-radius;
    out property <length> project-settings-chrome-x: project-settings.card-x;
    out property <length> project-settings-chrome-y: project-settings.card-y;
    out property <length> project-settings-chrome-width: project-settings.card-width;
    out property <length> project-settings-chrome-height: project-settings.card-height;
    out property <length> project-settings-chrome-radius: project-settings.card-radius;
    out property <length> layer-settings-chrome-x: layer-settings.card-x;
    out property <length> layer-settings-chrome-y: layer-settings.card-y;
    out property <length> layer-settings-chrome-width: layer-settings.card-width;
    out property <length> layer-settings-chrome-height: layer-settings.card-height;
    out property <length> layer-settings-chrome-radius: layer-settings.card-radius;
    out property <bool> tip-visible: Tip.open && Tip.text != "";
    out property <length> tip-chrome-x: tip.bubble-x;
    out property <length> tip-chrome-y: tip.bubble-y;
    out property <length> tip-chrome-width: tip.bubble-width;
    out property <length> tip-chrome-height: tip.bubble-height;
    out property <length> tip-chrome-radius: tip.bubble-radius;

    in property <bool> toast-visible;
    in property <string> toast-text;
    in property <bool> toast-is-error;

    out property <bool> overlay-chrome-open: root.loading
        || root.settings-open
        || root.toast-visible;

    init => {
        focus-scope.focus();
    }

    title: "";
    preferred-width: 960px;
    preferred-height: 520px;
    min-width: Tokens.main-min-width;
    min-height: Tokens.main-min-height;
    background: Theme.bg;

    MenuBar {
        Menu {
            title: MenuChrome.file-title;
            MenuItem {
                title: MenuChrome.new-project-title;
                enabled: root.editor-open;
                activated => {
                    MenuChrome.new-project();
                }
            }
            Menu {
                title: MenuChrome.export-title;
                enabled: root.editor-open;
                MenuItem {
                    title: MenuChrome.export-png-title;
                    activated => {
                        MenuChrome.export-png();
                    }
                }
                MenuItem {
                    title: MenuChrome.export-jpeg-title;
                    activated => {
                        MenuChrome.export-jpeg();
                    }
                }
                MenuItem {
                    title: MenuChrome.export-webp-title;
                    activated => {
                        MenuChrome.export-webp();
                    }
                }
                MenuItem {
                    title: MenuChrome.export-avif-title;
                    activated => {
                        MenuChrome.export-avif();
                    }
                }
                MenuItem {
                    title: MenuChrome.export-heic-title;
                    activated => {
                        MenuChrome.export-heic();
                    }
                }
                MenuItem {
                    title: MenuChrome.export-psd-title;
                    activated => {
                        MenuChrome.export-psd();
                    }
                }
                MenuItem {
                    title: MenuChrome.export-svg-title;
                    activated => {
                        MenuChrome.export-svg();
                    }
                }
                MenuItem {
                    title: MenuChrome.export-pdf-title;
                    activated => {
                        MenuChrome.export-pdf();
                    }
                }
            }
        }
        Menu {
            title: MenuChrome.edit-title;
            MenuItem {
                title: MenuChrome.undo-title;
                enabled: root.editor-open && MenuChrome.can-undo;
                activated => {
                    MenuChrome.undo();
                }
            }
            MenuItem {
                title: MenuChrome.redo-title;
                enabled: root.editor-open && MenuChrome.can-redo;
                activated => {
                    MenuChrome.redo();
                }
            }
        }
        Menu {
            title: MenuChrome.board-title;
            MenuItem {
                title: MenuChrome.settings-title;
                activated => {
                    MenuChrome.settings();
                }
            }
            MenuItem {
                title: MenuChrome.fit-view-title;
                enabled: root.editor-open;
                activated => {
                    MenuChrome.fit-view();
                }
            }
            MenuItem {
                title: MenuChrome.toggle-layers-title;
                enabled: root.editor-open;
                checkable: true;
                checked: root.layers-open;
                activated => {
                    MenuChrome.toggle-layers();
                }
            }
            MenuItem {
                title: MenuChrome.fullscreen-title;
                activated => {
                    MenuChrome.fullscreen();
                }
            }
        }
    }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            root.shell-key-pressed(
                event.text,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
                event.modifiers.alt,
            );
            accept;
        }

        key-released(event) => {
            root.shell-key-released(
                event.text,
                event.modifiers.control,
                event.modifiers.meta,
                event.modifiers.shift,
                event.modifiers.alt,
            );
            accept;
        }

        Landing {
            width: 100%;
            height: 100%;
            visible: !root.editor-open;
        }

        editor := Editor {
            width: 100%;
            height: 100%;
            visible: root.editor-open;
            loading: root.loading;
            loading-paper-x: root.loading-paper-x;
            loading-paper-y: root.loading-paper-y;
            loading-paper-width: root.loading-paper-width;
            loading-paper-height: root.loading-paper-height;
            layers-open: root.layers-open;
            layer-settings-open: root.layer-settings-open;
            pointer-pressed(x, y, middle, meta, alt, shift) => {
                focus-scope.focus();
                root.pointer-pressed(x, y, middle, meta, alt, shift);
            }
            pointer-moved(x, y) => {
                root.pointer-moved(x, y);
            }
            pointer-released(x, y) => {
                root.pointer-released(x, y);
            }
            pointer-enter => {
                focus-scope.focus();
                root.pointer-enter();
            }
            pointer-exit => {
                root.pointer-exit();
            }
            scrolled(x, y, dx, dy, alt, meta) => {
                focus-scope.focus();
                root.scrolled(x, y, dx, dy, alt, meta);
            }
            pinch-started => {
                focus-scope.focus();
                root.pinch-started();
            }
            pinch-updated(x, y, scale) => {
                root.pinch-updated(x, y, scale);
            }
            pinch-ended => {
                root.pinch-ended();
            }
        }

        Titlebar {
            z: 10;
            y: 0;
            width: 100%;
            editor-open: root.editor-open;
            drag => {
                root.titlebar-drag();
            }
            zoom => {
                root.titlebar-zoom();
            }
        }

        SettingsModal {
            z: 20;
            open <=> root.settings-open;
            dim-scrim: true;
        }

        new-project-card := NewProjectModal {
            z: 20;
            open <=> root.new-project-open;
            dim-scrim: !root.editor-open;
        }

        guides-card := GuidesCard {
            z: 20;
            open <=> root.guides-open;
            dim-scrim: !root.editor-open;
        }

        layer-settings := LayerSettingsModal {
            z: 20;
            open <=> root.layer-settings-open;
            board-x: editor.board-x;
            board-y: editor.board-y;
            board-width: editor.board-width;
            board-height: editor.board-height;
        }

        project-settings := ProjectSettingsPopover {
            z: 25;
            open <=> root.project-settings-open;
        }

        ToastBanner {
            show: root.toast-visible;
            text: root.toast-text;
            is-error: root.toast-is-error;
            dismiss => {
                root.toast-dismissed();
            }
        }
    }

    tip-delay := Timer {
        interval: 450ms;
        running: Tip.armed && !Tip.open;
        triggered => {
            Tip.open = true;
        }
    }

    tip := CalmTip {
        z: 40;
    }
}
