import { ProjectTabRow } from "models.slint";
import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmDot } from "calm/CalmDot.slint";
import { CalmIconButton } from "calm/CalmToolButton.slint";

component ProjectTabChip inherits Rectangle {
    in property <ProjectTabRow> tab;
    in property <string> close-tip;

    callback switch-tab();
    callback close-tab();

    height: Tokens.control-height;
    background: root.tab.active ? Theme.surface-hover : transparent;

    name-touch := CalmPointer {
        clicked => {
            root.switch-tab();
        }
    }

    HorizontalLayout {
        padding-left: Tokens.space-sm;
        padding-right: Tokens.space-sm;
        spacing: Tokens.space-xs;

        CalmDot {
            dot-color: root.tab.accent;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.tab.name;
            font-size: Tokens.label-size;
            font-weight: root.tab.active ? 600 : 500;
            color: root.tab.active ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }

        close-touch := CalmPointer {
            width: Tokens.space-md;
            Text {
                text: "×";
                font-size: Tokens.label-size;
                font-weight: 500;
                color: close-touch.has-hover ? Theme.text : Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            clicked => {
                root.close-tab();
            }
        }
    }
}

export component ProjectTabs inherits Rectangle {
    in property <[ProjectTabRow]> tabs;
    in property <string> close-tip;
    in property <string> new-project-tip;

    callback switch-tab(string);
    callback close-tab(string);
    callback new-project();

    private property <image> icon-plus: @image-url("plus.svg");

    height: Tokens.control-height;
    width: strip.preferred-width;
    border-radius: self.height / 2;
    background: Theme.surface;
    clip: true;

    strip := HorizontalLayout {
        padding-left: Tokens.space-xs;
        padding-right: Tokens.space-xs;

        for tab in root.tabs: ProjectTabChip {
            tab: tab;
            close-tip: root.close-tip;
            switch-tab => {
                root.switch-tab(tab.id);
            }
            close-tab => {
                root.close-tab(tab.id);
            }
        }

        Rectangle {
            width: Tokens.control-height;

            CalmIconButton {
                icon: root.icon-plus;
                icon-size: 14px;
                tip: root.new-project-tip;
                tip-leading: false;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.new-project();
                }
            }
        }
    }
}
