import { RecentRow, PresetRow } from "models.slint";
import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmScrollView } from "calm/CalmScrollView.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmAccentButton } from "calm/CalmButton.slint";
import { CalmSectionLabel } from "calm/CalmSectionLabel.slint";
import { CalmSurface } from "calm/CalmSurface.slint";
import { CalmField } from "calm/CalmField.slint";
import { CalmDot } from "calm/CalmDot.slint";
import { CalmRow, CalmThumb } from "calm/CalmRow.slint";
import { CalmBrand, CalmEyebrow, CalmLabel, CalmMuted } from "calm/CalmText.slint";
import { CalmIconButton } from "calm/CalmToolButton.slint";
import { PasteArtworkIsland } from "paste-artwork-island.slint";

component PresetCard inherits CalmSurface {
    in property <PresetRow> preset;
    in property <image> icon;

    callback activated();

    bordered: true;
    hover: touch.has-hover;

    touch := CalmPointer {
        clicked => {
            root.activated();
        }
    }

    HorizontalLayout {
        padding-left: Tokens.space-md;
        padding-right: Tokens.space-md;
        padding-top: Tokens.space-sm;
        padding-bottom: Tokens.space-sm;

        CalmRow {
            title: root.preset.label;
            subtitle: root.preset.width + " × " + root.preset.height;
            title-large: true;

            Image {
                source: root.icon;
                width: Tokens.row-icon-size;
                height: Tokens.row-icon-size;
                colorize: Theme.text-muted;
                image-fit: contain;
            }
        }
    }
}

component RecentCard inherits CalmSurface {
    in property <RecentRow> recent;
    in property <image> trash-icon;
    in property <string> delete-tip;

    callback activated();
    callback deleted();

    bordered: true;
    hover: touch.has-hover;

    touch := CalmPointer {
        clicked => {
            root.activated();
        }
    }

    HorizontalLayout {
        padding-left: Tokens.space-md;
        padding-right: Tokens.space-md;
        padding-top: Tokens.space-sm;
        padding-bottom: Tokens.space-sm;
        spacing: Tokens.space-sm;

        CalmRow {
            title: root.recent.name;
            subtitle: root.recent.size-text;
            trailing: root.recent.time-text;

            CalmThumb {
                thumb: root.recent.thumb;
                tint: root.recent.accent;
                has-tint: true;
            }
        }

        Rectangle {
            width: Tokens.row-icon-size;
            y: (parent.height - self.height) / 2;
            height: Tokens.row-icon-size;

            if touch.has-hover: CalmIconButton {
                icon: root.trash-icon;
                tint: Theme.danger;
                tip: root.delete-tip;
                clicked => {
                    root.deleted();
                }
            }
        }
    }
}

export component ProjectForm inherits Rectangle {
    in property <string> brand-text;
    in property <string> tagline-text;
    in property <string> project-name-label;
    in property <string> resolution-label;
    in property <string> create-label;
    in property <string> presets-label;
    in property <string> recents-label;
    in property <string> clear-all-label;
    in property <string> no-recents-label;
    in property <string> delete-project-label;
    in property <string> paste-artwork-title;
    in property <string> paste-artwork-hint;
    in property <string> artwork-formats;
    in property <image> app-icon;

    in-out property <string> project-name;
    in-out property <string> width-text;
    in-out property <string> height-text;

    in property <[PresetRow]> presets;
    in property <[RecentRow]> recents;

    callback create-clicked();
    callback preset-clicked(int, int);
    callback recent-clicked(string);
    callback delete-recent(string);
    callback clear-all-clicked();
    callback paste-artwork-clicked();
    callback app-icon-clicked();

    private property <image> icon-plus: @image-url("plus.svg");
    private property <image> icon-trash: @image-url("trash.svg");

    HorizontalLayout {
        padding: Tokens.space-lg;
        spacing: Tokens.space-lg;

        VerticalLayout {
            horizontal-stretch: 2;
            spacing: Tokens.space-lg;

            HorizontalLayout {
                spacing: Tokens.space-sm;
                vertical-stretch: 0;

                CalmBrand {
                    text: root.brand-text;
                }

                CalmEyebrow {
                    label: root.tagline-text;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: Tokens.brand-size;
                    height: Tokens.brand-size;
                    border-radius: Tokens.radius-md;
                    clip: true;

                    cat := CalmPointer {
                        clicked => {
                            root.app-icon-clicked();
                        }
                    }

                    Image {
                        source: root.app-icon;
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                        opacity: cat.pressed ? 0.65 : 1.0;

                        animate opacity {
                            duration: 90ms;
                            easing: ease-out;
                        }
                    }
                }
            }

            CalmScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Tokens.space-lg;
                    padding-right: Tokens.space-md;
                    alignment: start;

                    VerticalLayout {
                        spacing: Tokens.space-xs;

                        CalmLabel {
                            label: root.project-name-label;
                        }

                        HorizontalLayout {
                            spacing: Tokens.space-sm;

                            CalmDot {
                                dot-color: Theme.accent-teal;
                                dot-size: 16px;
                                y: (parent.height - self.height) / 2;
                            }

                            CalmField {
                                text <=> root.project-name;
                                horizontal-stretch: 1;
                                accepted(text) => {
                                    root.create-clicked();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Tokens.space-xs;

                        CalmLabel {
                            label: root.resolution-label;
                        }

                        HorizontalLayout {
                            spacing: Tokens.space-sm;
                            alignment: start;

                            CalmField {
                                text <=> root.width-text;
                                width: 72px;
                                accepted(text) => {
                                    root.create-clicked();
                                }
                            }

                            CalmField {
                                text <=> root.height-text;
                                width: 72px;
                                accepted(text) => {
                                    root.create-clicked();
                                }
                            }

                            CalmAccentButton {
                                text: root.create-label;
                                clicked => {
                                    root.create-clicked();
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Tokens.space-lg;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            spacing: Tokens.space-md;
                            alignment: start;

                            CalmSectionLabel {
                                label: root.presets-label;
                                accent: Theme.accent-teal;
                            }

                            VerticalLayout {
                                spacing: Tokens.space-sm;

                                for preset in root.presets: PresetCard {
                                    preset: preset;
                                    icon: root.icon-plus;
                                    activated => {
                                        root.preset-clicked(preset.width, preset.height);
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            spacing: Tokens.space-md;
                            alignment: start;

                            HorizontalLayout {
                                spacing: Tokens.space-sm;

                                CalmSectionLabel {
                                    label: root.recents-label;
                                    accent: Theme.accent-orange;
                                    horizontal-stretch: 1;
                                }

                                if root.recents.length > 0: CalmPointer {
                                    Text {
                                        text: root.clear-all-label;
                                        font-size: Tokens.label-size;
                                        color: Theme.danger;
                                        vertical-alignment: center;
                                    }
                                    clicked => {
                                        root.clear-all-clicked();
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: Tokens.space-sm;

                                if root.recents.length == 0: CalmSurface {
                                    bordered: true;
                                    height: Tokens.control-height + Tokens.space-sm;

                                    CalmMuted {
                                        x: Tokens.space-sm;
                                        height: 100%;
                                        text: root.no-recents-label;
                                    }
                                }

                                for recent in root.recents: RecentCard {
                                    recent: recent;
                                    trash-icon: root.icon-trash;
                                    delete-tip: root.delete-project-label;
                                    activated => {
                                        root.recent-clicked(recent.id);
                                    }
                                    deleted => {
                                        root.delete-recent(recent.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        PasteArtworkIsland {
            horizontal-stretch: 1;
            max-width: Tokens.paste-max-width;
            title-text: root.paste-artwork-title;
            hint-text: root.paste-artwork-hint;
            formats-text: root.artwork-formats;
            clicked => {
                root.paste-artwork-clicked();
            }
        }
    }
}
