import { RecentRow, PresetRow } from "models.slint";
import { ProjectChrome } from "project-chrome.slint";
import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmScrollView } from "calm/CalmScrollView.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmAccentButton } from "calm/CalmButton.slint";
import { CalmSectionLabel } from "calm/CalmSectionLabel.slint";
import { CalmSurface } from "calm/CalmSurface.slint";
import { CalmField } from "calm/CalmField.slint";
import { CalmPalettePopover } from "calm/CalmPalettePopover.slint";
import { CalmRow, CalmThumb } from "calm/CalmRow.slint";
import { CalmBrand, CalmEyebrow, CalmLabel, CalmMuted } from "calm/CalmText.slint";
import { CalmIconButton } from "calm/CalmToolButton.slint";
import { PasteArtworkIsland } from "paste-artwork-island.slint";

component PresetCard inherits CalmSurface {
    in property <PresetRow> preset;
    in property <image> icon;

    callback activated();

    bordered: true;
    hover: touch.has-hover;

    touch := CalmPointer {
        clicked => {
            root.activated();
        }
    }

    HorizontalLayout {
        padding-left: Tokens.space-md;
        padding-right: Tokens.space-md;
        padding-top: Tokens.space-sm;
        padding-bottom: Tokens.space-sm;

        CalmRow {
            title: root.preset.label;
            subtitle: root.preset.width + " × " + root.preset.height;
            title-large: true;

            Image {
                source: root.icon;
                width: Tokens.row-icon-size;
                height: Tokens.row-icon-size;
                colorize: Theme.text-muted;
                image-fit: contain;
            }
        }
    }
}

component RecentCard inherits CalmSurface {
    in property <RecentRow> recent;
    in property <image> trash-icon;
    in property <string> delete-tip;

    callback activated();
    callback deleted();

    private property <bool> row-hovered: row-touch.has-hover || trash-hot.has-hover;

    bordered: true;
    clip: true;
    hover: root.row-hovered;

    HorizontalLayout {
        padding-right: Tokens.space-sm;
        spacing: Tokens.space-sm;

        row-touch := CalmPointer {
            horizontal-stretch: 1;
            clicked => {
                root.activated();
            }

            CalmRow {
                title: root.recent.name;
                subtitle: root.recent.size-text;
                trailing: root.recent.time-text;
                spacing: Tokens.space-sm;
                horizontal-stretch: 1;

                CalmThumb {
                    thumb: root.recent.thumb;
                    tint: root.recent.accent;
                    has-tint: true;
                    width: Tokens.layer-thumb-height;
                    height: Tokens.layer-thumb-height;
                }
            }
        }

        trash-hot := CalmPointer {
            width: Tokens.row-icon-size;

            if root.row-hovered: CalmIconButton {
                icon: root.trash-icon;
                tint: Theme.danger;
                tip: root.delete-tip;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.deleted();
                }
            }
        }
    }
}

export component ProjectForm inherits Rectangle {
    callback create-clicked();

    private property <image> icon-plus: @image-url("plus.svg");
    private property <image> icon-trash: @image-url("trash.svg");

    HorizontalLayout {
        padding: Tokens.space-lg;
        spacing: Tokens.space-lg;

        VerticalLayout {
            horizontal-stretch: 2;
            spacing: Tokens.space-lg;

            HorizontalLayout {
                spacing: Tokens.space-sm;
                vertical-stretch: 0;

                CalmBrand {
                    text: ProjectChrome.brand-text;
                }

                CalmEyebrow {
                    label: ProjectChrome.tagline-text;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: Tokens.brand-size;
                    height: Tokens.brand-size;
                    border-radius: Tokens.radius-md;
                    clip: true;

                    cat := CalmPointer {
                        clicked => {
                            ProjectChrome.app-icon-clicked();
                        }
                    }

                    Image {
                        source: ProjectChrome.app-icon;
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                        opacity: cat.pressed ? 0.65 : 1.0;

                        animate opacity {
                            duration: 90ms;
                            easing: ease-out;
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: Tokens.space-xs;
                vertical-stretch: 0;

                CalmLabel {
                    label: ProjectChrome.name-label;
                }

                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    alignment: stretch;

                    CalmPalettePopover {
                        palette: ProjectChrome.palette;
                        selected-index <=> ProjectChrome.accent-index;
                        well-size: Tokens.control-height;
                    }

                    CalmField {
                        text <=> ProjectChrome.name;
                        horizontal-stretch: 1;
                        min-width: 160px;
                    }
                }
            }

            VerticalLayout {
                spacing: Tokens.space-xs;
                vertical-stretch: 0;

                CalmLabel {
                    label: ProjectChrome.resolution-label;
                }

                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    alignment: start;

                    CalmField {
                        text <=> ProjectChrome.width-text;
                        width: 72px;
                        accepted(text) => {
                            root.create-clicked();
                        }
                    }

                    CalmField {
                        text <=> ProjectChrome.height-text;
                        width: 72px;
                        accepted(text) => {
                            root.create-clicked();
                        }
                    }

                    CalmAccentButton {
                        text: ProjectChrome.create-label;
                        clicked => {
                            root.create-clicked();
                        }
                    }
                }
            }

            CalmScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: Tokens.space-lg;
                    padding-right: Tokens.space-md;
                    alignment: start;

                    HorizontalLayout {
                        spacing: Tokens.space-lg;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            spacing: Tokens.space-md;
                            alignment: start;

                            CalmSectionLabel {
                                label: ProjectChrome.presets-label;
                                accent: Theme.accent-teal;
                            }

                            VerticalLayout {
                                spacing: Tokens.space-sm;

                                for preset in ProjectChrome.presets: PresetCard {
                                    preset: preset;
                                    icon: root.icon-plus;
                                    activated => {
                                        ProjectChrome.preset-size(preset.width, preset.height);
                                        root.create-clicked();
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            preferred-width: 0px;
                            min-width: 0px;
                            spacing: Tokens.space-md;
                            alignment: start;

                            HorizontalLayout {
                                spacing: Tokens.space-sm;

                                CalmSectionLabel {
                                    label: ProjectChrome.recents-label;
                                    accent: Theme.accent-orange;
                                    horizontal-stretch: 1;
                                }

                                if ProjectChrome.recents.length > 0: CalmPointer {
                                    Text {
                                        text: ProjectChrome.clear-all-label;
                                        font-size: Tokens.label-size;
                                        color: Theme.danger;
                                        vertical-alignment: center;
                                    }
                                    clicked => {
                                        ProjectChrome.clear-recents();
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: Tokens.space-sm;

                                if ProjectChrome.recents.length == 0: CalmSurface {
                                    bordered: true;
                                    height: Tokens.control-height + Tokens.space-sm;

                                    CalmMuted {
                                        x: Tokens.space-sm;
                                        height: 100%;
                                        text: ProjectChrome.no-recents-label;
                                    }
                                }

                                for recent in ProjectChrome.recents: RecentCard {
                                    recent: recent;
                                    trash-icon: root.icon-trash;
                                    delete-tip: ProjectChrome.delete-label;
                                    activated => {
                                        ProjectChrome.open-recent(recent.id);
                                    }
                                    deleted => {
                                        ProjectChrome.delete-recent(recent.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        PasteArtworkIsland {
            horizontal-stretch: 1;
            max-width: Tokens.paste-max-width;
            title-text: ProjectChrome.paste-artwork-title;
            hint-text: ProjectChrome.paste-artwork-hint;
            formats-text: ProjectChrome.artwork-formats;
            clicked => {
                ProjectChrome.paste-artwork-clicked();
            }
        }
    }
}
