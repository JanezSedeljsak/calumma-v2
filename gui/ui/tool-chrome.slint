import { ToolEntry, BrushEntry, FontFamilyRow } from "models.slint";

export global ToolChrome {
    in property <[ToolEntry]> tools;
    in property <string> active-tool-label;

    in-out property <bool> show-shapes: false;
    in-out property <bool> show-selection: false;
    in-out property <bool> show-brushes: false;
    in-out property <[ToolEntry]> shape-tools;
    in-out property <[ToolEntry]> select-tools;
    in-out property <[BrushEntry]> brush-tools;

    in-out property <bool> show-brush-size: false;
    in-out property <bool> show-ink-opacity: false;
    in-out property <bool> show-blur: false;
    in-out property <bool> show-hardness: false;
    in-out property <bool> show-tolerance: false;
    in-out property <bool> show-eyedropper: false;
    in-out property <bool> show-fill: false;
    in-out property <bool> show-vector: false;
    in-out property <bool> show-aligned: false;
    in-out property <bool> show-transform: false;
    in-out property <bool> show-crop: false;
    in-out property <bool> show-text: false;

    in-out property <string> brush-size-label;
    in-out property <string> ink-opacity-label;
    in-out property <string> blur-label;
    in-out property <string> hardness-label;
    in-out property <string> tolerance-label;
    in-out property <string> sample-label;
    in-out property <string> fill-label;
    in-out property <string> stroke-label;
    in-out property <string> vector-label;
    in-out property <string> aligned-label;
    in-out property <string> transform-label;
    in-out property <string> crop-aspect-label;
    in-out property <string> crop-overlay-label;
    in-out property <string> crop-free-label;
    in-out property <string> crop-square-label;
    in-out property <string> crop-four-three-label;
    in-out property <string> crop-three-two-label;
    in-out property <string> crop-sixteen-nine-label;
    in-out property <string> crop-five-four-label;
    in-out property <string> crop-overlay-off-label;
    in-out property <string> crop-overlay-thirds-label;
    in-out property <string> crop-overlay-grid-label;
    in-out property <string> crop-overlay-diagonal-label;
    in-out property <string> crop-overlay-golden-label;
    in-out property <string> crop-cancel-label;
    in-out property <string> crop-commit-label;

    in-out property <string> brush-size-text;
    in-out property <string> ink-opacity-text;
    in-out property <string> blur-text;
    in-out property <string> hardness-text;
    in-out property <string> tolerance-text;
    in-out property <string> eyedropper-text;

    in-out property <float> brush-size-unit;
    in-out property <float> ink-opacity;
    in-out property <float> blur-strength;
    in-out property <float> eraser-hardness;
    in-out property <float> tolerance-unit;
    in-out property <float> eyedropper-radius;

    in-out property <bool> fill-on: false;
    in-out property <bool> stroke-on: true;
    in-out property <bool> vector-on: false;
    in-out property <bool> vector-locked: false;
    in-out property <bool> clone-aligned: false;
    in-out property <bool> transform-on: false;
    in-out property <int> crop-aspect: 0;
    in-out property <int> crop-overlay: 1;

    in-out property <string> text-font-label;
    in-out property <string> text-size-label;
    in-out property <string> text-line-height-label;
    in-out property <string> text-wrap-label;
    in-out property <string> text-bold-label;
    in-out property <string> text-italic-label;
    in-out property <string> text-align-left-label;
    in-out property <string> text-align-center-label;
    in-out property <string> text-align-right-label;
    in-out property <string> text-no-fonts-label;

    in-out property <string> text-family;
    in-out property <string> text-size-text;
    in-out property <string> text-line-height-text;
    in-out property <string> text-wrap-text;
    in-out property <float> text-size-unit;
    in-out property <float> text-line-height;
    in-out property <float> text-line-height-min: 0.5;
    in-out property <float> text-line-height-max: 4.0;
    in-out property <float> text-wrap-width;
    in-out property <float> text-wrap-max;
    in-out property <bool> text-bold: false;
    in-out property <bool> text-italic: false;
    in-out property <bool> text-can-bold: false;
    in-out property <bool> text-can-italic: false;
    in-out property <int> text-align: 0;
    in-out property <string> text-font-query;
    in-out property <[FontFamilyRow]> font-families;

    callback pick-tool(int);
    callback pick-brush(int);
    callback brush-size-changed(float);
    callback brush-size-committed(string);
    callback ink-opacity-changed(float);
    callback blur-changed(float);
    callback hardness-changed(float);
    callback tolerance-changed(float);
    callback eyedropper-changed(float);
    callback fill-toggled();
    callback stroke-toggled();
    callback vector-toggled();
    callback aligned-toggled();
    callback transform-toggled();
    callback crop-aspect-changed(int);
    callback crop-overlay-changed(int);
    callback commit-crop();
    callback cancel-crop();

    in-out property <bool> show-smart-tools: false;
    in-out property <string> smart-tools-label;
    in-out property <string> remove-background-label;
    in-out property <bool> remove-background-enabled: false;

    callback remove-background();

    callback text-family-changed(string);
    callback text-size-changed(float);
    callback text-size-committed(string);
    callback text-line-height-changed(float);
    callback text-wrap-changed(float);
    callback text-bold-toggled();
    callback text-italic-toggled();
    callback text-align-changed(int);
    callback text-font-search(string);
}
