import { Tokens } from "calm/CalmTokens.slint";
import { CalmModal, CalmModalCard } from "calm/CalmModal.slint";
import { ProjectForm } from "project-form.slint";
import { ProjectChrome } from "project-chrome.slint";

export component NewProjectModal inherits Rectangle {
    in-out property <bool> open;
    in property <bool> dim-scrim: true;

    out property <length> card-x: card.absolute-position.x;
    out property <length> card-y: card.absolute-position.y;
    out property <length> card-width: card.width;
    out property <length> card-height: card.height;
    out property <length> card-radius: card.border-radius;

    width: 100%;
    height: 100%;
    visible: open;

    CalmModal {
        open <=> root.open;
        dim-scrim: root.dim-scrim;
        dismissed => {
            ProjectChrome.new-project-dismissed();
        }

        card := CalmModalCard {
            z: 1;
            width: min(Tokens.new-project-width, parent.width - Tokens.space-xl * 2);
            height: min(Tokens.new-project-height, parent.height - Tokens.space-xl * 2);
            clip: true;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            ProjectForm {
                width: 100%;
                height: 100%;
                create-clicked => {
                    ProjectChrome.create-from-modal();
                }
            }
        }
    }
}
