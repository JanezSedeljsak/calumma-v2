import { Theme } from "calm/CalmTheme.slint";
import { ProjectChrome } from "project-chrome.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmField } from "calm/CalmField.slint";
import { CalmMuted } from "calm/CalmText.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmPaletteRow } from "calm/CalmPaletteRow.slint";

export component ProjectSettingsPopover inherits Rectangle {
    in-out property <bool> open;

    private property <length> popover-width: 260px;

    out property <length> card-x: popover.x;
    out property <length> card-y: popover.y;
    out property <length> card-width: popover.width;
    out property <length> card-height: popover.height;
    out property <length> card-radius: popover.border-radius;

    width: 100%;
    height: 100%;
    visible: root.open;

    if root.open: CalmPointer {
        width: 100%;
        height: 100%;
        clicked => {
            root.open = false;
            ProjectChrome.settings-dismissed();
        }
    }

    popover := Rectangle {
        visible: root.open;
        z: 2;
        width: popover-width;
        height: card.preferred-height;
        x: max(Tokens.space-xs, min(ProjectChrome.settings-anchor-x * 1px, parent.width - self.width - Tokens.space-xs));
        y: min(ProjectChrome.settings-anchor-y * 1px + Tokens.space-xs, parent.height - self.height - Tokens.space-xs);
        background: Theme.surface;
        border-radius: Tokens.radius-md;
        border-width: 1px;
        border-color: Theme.island-border;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.shadow;
        clip: true;

        dismiss-swallow := CalmPointer { }

        card := VerticalLayout {
            padding: Tokens.space-md;
            spacing: Tokens.space-sm;

            CalmField {
                text <=> ProjectChrome.settings-name;
                accepted(text) => {
                    ProjectChrome.rename(text);
                }
            }

            CalmPaletteRow {
                palette: ProjectChrome.palette;
                selected-index: ProjectChrome.settings-accent-index;
                picked(index) => {
                    ProjectChrome.settings-accent-index = index;
                    ProjectChrome.recolor(index);
                }
            }

            CalmMuted {
                text: ProjectChrome.settings-size-text;
            }
        }
    }
}
