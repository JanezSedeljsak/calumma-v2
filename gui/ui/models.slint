export struct RecentRow {
    id: string,
    name: string,
    size-text: string,
    time-text: string,
    accent: color,
    thumb: image,
}

export struct PresetRow {
    label: string,
    width: int,
    height: int,
}

export struct LayerRow {
    index: int,
    name: string,
    visible: bool,
    locked: bool,
    active: bool,
    thumb: image,
}
