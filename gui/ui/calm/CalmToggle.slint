import { Theme } from "CalmTheme.slint";
import { CalmPointer } from "CalmPointer.slint";

export component CalmToggle inherits Rectangle {
    in property <bool> checked;

    callback toggled();

    width: 30px;
    height: 18px;
    border-radius: self.height / 2;
    background: checked ? Theme.accent-teal : Theme.surface-hover;
    border-width: 1px;
    border-color: checked ? Theme.accent-teal : Theme.control-border;

    touch := CalmPointer {
        clicked => {
            root.toggled();
        }
    }

    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: (parent.height - self.height) / 2;
        width: root.height - 6px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.checked ? Theme.bg : Theme.text-muted;

        animate x {
            duration: 120ms;
            easing: ease-out;
        }
    }
}
