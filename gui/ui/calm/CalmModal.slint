import { Theme } from "CalmTheme.slint";
import { Tokens } from "CalmTokens.slint";

export component CalmModalCard inherits Rectangle {
    background: Theme.bg;
    border-radius: Tokens.radius-window;
    border-width: 1px;
    border-color: Theme.island-border;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;

    swallow := TouchArea {
        width: 100%;
        height: 100%;
    }

    @children
}

export component CalmModal inherits Rectangle {
    in-out property <bool> open;
    in property <bool> dim-scrim: true;
    callback dismissed();

    visible: open;
    width: 100%;
    height: 100%;

    scrim := Rectangle {
        width: 100%;
        height: 100%;
        background: root.dim-scrim ? Theme.scrim : transparent;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.open = false;
                root.dismissed();
            }
        }
    }

    Rectangle {
        z: 1;
        width: parent.width;
        height: parent.height;

        @children
    }
}
