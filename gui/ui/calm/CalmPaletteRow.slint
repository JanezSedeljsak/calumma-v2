import { Theme } from "CalmTheme.slint";
import { Tokens } from "CalmTokens.slint";
import { CalmDot } from "CalmDot.slint";
import { CalmPointer } from "CalmPointer.slint";

export component CalmPaletteRow inherits HorizontalLayout {
    in property <[color]> palette;
    in property <int> selected-index: -1;
    in property <length> dot-size: Tokens.palette-dot-size;

    callback picked(int);

    spacing: Tokens.space-xs;
    vertical-stretch: 0;
    alignment: start;

    for swatch-color[i] in root.palette: Rectangle {
        width: root.dot-size + 6px;
        height: self.width;

        CalmDot {
            dot-color: swatch-color;
            dot-size: root.dot-size;
            selected: i == root.selected-index;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        CalmPointer {
            clicked => {
                root.picked(i);
            }
        }
    }
}
