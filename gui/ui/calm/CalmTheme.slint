export global Theme {
    in property <color> bg: #161C20;
    in property <color> surface: #1A2024;
    in property <color> surface-hover: #242C32;
    in property <color> text: #F2F5F7;
    in property <color> text-muted: #8A97A0;
    in property <color> accent-teal: #3CC9D6;
    in property <color> accent-orange: #F0944A;
    in property <color> island-border: #FFFFFF1F;
    in property <color> control-border: #FFFFFF33;
    in property <color> control-focus-border: #3CC9D6CC;
    in property <color> danger: #E85A5A;
    in property <color> paper: #1C242B;

    out property <brush> brand-gradient: @linear-gradient(90deg, accent-teal 0%, accent-orange 100%);
    out property <color> scrim: #00000059;
    out property <color> shadow: #00000059;
}
