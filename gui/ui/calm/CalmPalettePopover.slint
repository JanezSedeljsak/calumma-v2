import { Theme } from "CalmTheme.slint";
import { Tokens } from "CalmTokens.slint";
import { CalmDot } from "CalmDot.slint";
import { CalmPointer } from "CalmPointer.slint";
import { CalmPaletteRow } from "CalmPaletteRow.slint";

export component CalmPalettePopover inherits Rectangle {
    in property <[color]> palette;
    in-out property <int> selected-index: 0;
    in property <length> well-size: Tokens.control-height;

    callback picked(int);

    width: well-size;
    height: well-size;

    private property <color> fill-color: root.palette.length == 0 ? Theme.accent-teal : root.palette[max(0, min(root.selected-index, root.palette.length - 1))];

    well := CalmDot {
        dot-color: root.fill-color;
        dot-size: root.well-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    CalmPointer {
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: 0px;
        y: root.height + Tokens.space-xs;

        Rectangle {
            background: Theme.surface;
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: Theme.island-border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.shadow;

            HorizontalLayout {
                padding: Tokens.space-sm;

                CalmPaletteRow {
                    palette: root.palette;
                    selected-index: root.selected-index;
                    picked(index) => {
                        root.selected-index = index;
                        popup.close();
                        root.picked(index);
                    }
                }
            }
        }
    }
}
