import { Theme } from "CalmTheme.slint";
import { Tokens } from "CalmTokens.slint";

export component CalmBrand inherits Text {
    font-size: Tokens.brand-size;
    font-weight: 700;
    color: Theme.brand-gradient;
    vertical-alignment: center;
}

export component CalmEyebrow inherits Text {
    in property <string> label;
    text: label.to-uppercase();
    font-size: Tokens.label-size;
    font-weight: 600;
    letter-spacing: 1.2px;
    color: Theme.text-muted;
    vertical-alignment: center;
}

export component CalmLabel inherits Text {
    in property <string> label;
    text: label.to-uppercase();
    font-size: Tokens.label-size;
    font-weight: 600;
    letter-spacing: Tokens.label-tracking;
    color: Theme.text-muted;
    vertical-alignment: center;
}

export component CalmTitle inherits Text {
    in property <bool> strong: false;
    font-size: Tokens.title-size;
    font-weight: strong ? 700 : 600;
    color: Theme.text;
    vertical-alignment: center;
}

export component CalmBody inherits Text {
    in property <bool> strong: false;
    font-size: Tokens.body-size;
    font-weight: strong ? 600 : 400;
    color: Theme.text;
    vertical-alignment: center;
}

export component CalmMuted inherits Text {
    in property <bool> mono: false;
    font-size: Tokens.label-size;
    font-weight: mono ? 500 : 400;
    font-family: mono ? "Menlo" : "";
    color: Theme.text-muted;
    vertical-alignment: center;
}
