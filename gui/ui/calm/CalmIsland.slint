import { Theme } from "CalmTheme.slint";
import { Tokens } from "CalmTokens.slint";

export component CalmIsland inherits Rectangle {
    in property <length> island-padding: Tokens.space-md;

    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.island-border;
    border-radius: Tokens.radius-island;

    @children
}
