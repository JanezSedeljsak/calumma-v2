import { VerticalBox } from "std-widgets.slint";
import { CalmSlider } from "CalmSlider.slint";

export component CalmSliderRow inherits VerticalBox {
    in property <string> label;
    in property <string> value-text;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    in property <brush> label-color;
    in property <brush> track-color;
    in property <brush> fill-color;
    in property <brush> handle-color;
    in property <brush> handle-border-color;
    in property <brush> handle-focus-border-color;

    callback moved(float);

    spacing: 2px;

    HorizontalLayout {
        Text {
            text: root.label;
            color: label-color;
            font-size: 11px;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value-text;
            color: label-color;
            font-size: 11px;
            font-family: "Menlo";
        }
    }

    CalmSlider {
        minimum: root.minimum;
        maximum: root.maximum;
        value <=> root.value;
        track-color: root.track-color;
        fill-color: root.fill-color;
        handle-color: root.handle-color;
        handle-border-color: root.handle-border-color;
        handle-focus-border-color: root.handle-focus-border-color;
        moved(value) => { root.moved(value); }
    }
}
