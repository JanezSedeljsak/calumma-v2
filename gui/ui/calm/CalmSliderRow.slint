import { Tokens } from "CalmTokens.slint";
import { CalmMuted } from "CalmText.slint";
import { CalmSlider } from "CalmSlider.slint";
import { CalmSliderValueField } from "CalmField.slint";

export component CalmSliderRow inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value-text;
    in property <bool> editable: false;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;

    callback moved(float);
    callback committed(string);

    spacing: 2px;

    HorizontalLayout {
        spacing: Tokens.space-xs;
        alignment: space-between;

        CalmMuted {
            text: root.label;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if editable: CalmSliderValueField {
            text <=> root.value-text;
            accepted(text) => {
                root.committed(text);
            }
        }

        if !editable: CalmMuted {
            text: root.value-text;
            mono: true;
        }
    }

    CalmSlider {
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        moved(v) => {
            root.moved(v);
        }
    }
}
