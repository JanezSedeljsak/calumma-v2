export component CalmSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value: 0;
    in property <brush> track-color;
    in property <brush> fill-color;
    in property <brush> handle-color;
    in property <brush> handle-border-color;
    in property <brush> handle-focus-border-color;

    callback moved(float);

    height: 20px;

    property <float> fraction: (maximum - minimum) == 0 ? 0 : (value - minimum) / (maximum - minimum);

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: track-color;

        Rectangle {
            width: parent.width * root.fraction;
            height: parent.height;
            border-radius: parent.border-radius;
            background: fill-color;
        }
    }

    track-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && self.pressed)) {
                let track = (parent.width / 1px) - 12;
                let next = (self.mouse-x / 1px) / max(1, track);
                root.value = root.minimum + next * (root.maximum - root.minimum);
                root.moved(root.value);
            }
        }
    }

    Rectangle {
        x: root.fraction * (parent.width - 12px);
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: handle-color;
        border-width: 1px;
        border-color: track-touch.pressed ? handle-focus-border-color : handle-border-color;
    }
}
