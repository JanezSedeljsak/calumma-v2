export component CalmDot inherits Rectangle {
    in property <color> dot-color;
    in property <length> dot-size: 9px;
    in property <bool> selected: false;

    width: dot-size + (selected ? 6px : 0px);
    height: self.width;
    border-radius: self.width / 2;
    background: transparent;
    border-width: selected ? 2px : 0px;
    border-color: root.dot-color;

    Rectangle {
        width: root.dot-size;
        height: root.dot-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.dot-color;
    }
}
