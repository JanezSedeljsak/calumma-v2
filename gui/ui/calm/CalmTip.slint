import { Theme } from "CalmTheme.slint";
import { Tokens } from "CalmTokens.slint";

export global Tip {
    in-out property <bool> armed: false;
    in-out property <bool> open: false;
    in-out property <string> text;
    in-out property <string> shortcut;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> leading: false;
}

export component CalmTip inherits Rectangle {
    in property <string> tip;
    in property <string> shortcut;

    z: 200;
    width: content.preferred-width;
    height: content.preferred-height;
    background: Theme.surface-hover;
    border-radius: Tokens.radius-sm;
    border-width: 1px;
    border-color: Theme.island-border;

    content := HorizontalLayout {
        padding-left: Tokens.space-sm;
        padding-right: Tokens.space-sm;
        padding-top: Tokens.space-xs;
        padding-bottom: Tokens.space-xs;
        spacing: Tokens.space-sm;

        Text {
            text: root.tip;
            color: Theme.text;
            font-size: Tokens.label-size;
            font-weight: 500;
            vertical-alignment: center;
        }

        if shortcut != "": Text {
            text: root.shortcut;
            color: Theme.text-muted;
            font-size: Tokens.label-size;
            font-weight: 600;
            font-family: "Menlo";
            vertical-alignment: center;
        }
    }
}
