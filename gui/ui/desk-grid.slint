import { Theme } from "calm/CalmTheme.slint";

export component DeskGrid inherits Rectangle {
    private property <length> cell: 26px;
    private property <int> cols: Math.max(0, Math.ceil(root.width / 1px / 26));
    private property <int> rows: Math.max(0, Math.ceil(root.height / 1px / 26));

    background: Theme.desk;
    clip: true;

    for col[c] in root.cols: Rectangle {
        x: (c + 1) * root.cell - 1px;
        width: 1px;
        height: 100%;
        background: Theme.desk-grid;
    }

    for row[r] in root.rows: Rectangle {
        y: (r + 1) * root.cell - 1px;
        width: 100%;
        height: 1px;
        background: Theme.desk-grid;
    }
}
