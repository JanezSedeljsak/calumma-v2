import { ToolEntry } from "models.slint";
import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmScrollView } from "calm/CalmScrollView.slint";
import { CalmIsland } from "calm/CalmIsland.slint";
import { CalmDivider } from "calm/CalmDivider.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmToolButton } from "calm/CalmToolButton.slint";
import { CalmLabel } from "calm/CalmText.slint";
import { QuickColorPicker } from "quick-color-picker.slint";
import { ColorChrome } from "color-chrome.slint";
import { ToolOptions } from "tool-options.slint";
import { ToolChrome } from "tool-chrome.slint";
import { Tip } from "calm/CalmTip.slint";

component ToolGrid inherits VerticalLayout {
    in property <[ToolEntry]> tools;
    in property <[image]> icons;

    callback pick(int);

    spacing: Tokens.tool-grid-gap;

    for row in [0, 1, 2, 3]: HorizontalLayout {
        spacing: Tokens.tool-grid-gap;

        for column in [0, 1, 2]: Rectangle {
            horizontal-stretch: 1;
            height: Tokens.tool-button-size;

            if row * 3 + column < root.tools.length: CalmToolButton {
                x: (parent.width - self.width) / 2;
                icon: root.icons[root.tools[row * 3 + column].icon];
                tip: root.tools[row * 3 + column].tip;
                shortcut: root.tools[row * 3 + column].shortcut;
                enabled: root.tools[row * 3 + column].enabled;
                selected: root.tools[row * 3 + column].selected;
                clicked => {
                    root.pick(root.tools[row * 3 + column].id);
                }
            }
        }
    }
}

component SmartAction inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;

    callback clicked();

    horizontal-stretch: 1;
    height: max(Tokens.control-height, label.preferred-height + Tokens.space-sm);
    border-radius: Tokens.radius-sm;
    border-width: 1px;
    border-color: Theme.control-border;
    background: touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface;

    touch := CalmPointer {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    label := Text {
        x: Tokens.space-sm;
        y: (parent.height - self.height) / 2;
        width: parent.width - Tokens.space-sm * 2;
        text: root.text;
        wrap: word-wrap;
        horizontal-alignment: center;
        color: root.enabled ? Theme.accent-teal : Theme.text-muted;
        font-size: Tokens.label-size;
        font-weight: 600;
    }
}

export component ToolsPanel inherits CalmIsland {
    private property <[image]> tool-icons: [
        @image-url("move.svg"),
        @image-url("select-rect.svg"),
        @image-url("pen.svg"),
        @image-url("eraser.svg"),
        @image-url("blur.svg"),
        @image-url("clone.svg"),
        @image-url("heal.svg"),
        @image-url("shape.svg"),
        @image-url("bucket.svg"),
        @image-url("eyedropper.svg"),
        @image-url("text.svg"),
        @image-url("crop.svg"),
        @image-url("line.svg"),
        @image-url("ellipse.svg"),
        @image-url("arrow.svg"),
        @image-url("triangle.svg"),
        @image-url("pentagon.svg"),
        @image-url("select-ellipse.svg"),
        @image-url("select-lasso.svg"),
        @image-url("magic-wand.svg"),
        @image-url("select-color.svg"),
        @image-url("transform.svg"),
    ];
    private property <[image]> brush-icons: [
        @image-url("pen.svg"),
        @image-url("marker.svg"),
        @image-url("crayon.svg"),
        @image-url("airbrush.svg"),
    ];

    width: Tokens.tools-panel-width;
    island-padding: Tokens.space-xs;

    VerticalLayout {
        x: root.island-padding;
        y: root.island-padding;
        width: parent.width - root.island-padding * 2;
        height: parent.height - root.island-padding * 2;
        spacing: Tokens.space-sm;

        ToolGrid {
            tools: ToolChrome.tools;
            icons: root.tool-icons;
            pick(id) => {
                ToolChrome.pick-tool(id);
            }
        }

        CalmDivider { }

        CalmScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                spacing: Tokens.space-sm;
                alignment: start;

                CalmLabel {
                    label: ToolChrome.active-tool-label;
                    horizontal-alignment: center;
                }

                ToolOptions {
                    tool-icons: root.tool-icons;
                    brush-icons: root.brush-icons;
                }
            }
        }

        CalmDivider { }

        VerticalLayout {
            vertical-stretch: 0;
            spacing: Tokens.space-xs;

            CalmLabel {
                label: ColorChrome.label;
                horizontal-alignment: center;
            }

            QuickColorPicker {
                swatch0: ColorChrome.swatch0;
                swatch1: ColorChrome.swatch1;
                swatch2: ColorChrome.swatch2;
                swatch3: ColorChrome.swatch3;
                active-swatch: ColorChrome.active-swatch;
                hue-color: ColorChrome.hue-color;
                primary-tip: ColorChrome.primary-tip;
                secondary-tip: ColorChrome.secondary-tip;
                tertiary-tip: ColorChrome.tertiary-tip;
                quaternary-tip: ColorChrome.quaternary-tip;
                sb-x <=> ColorChrome.sb-x;
                sb-y <=> ColorChrome.sb-y;
                hue-x <=> ColorChrome.hue-x;
                hex-text <=> ColorChrome.hex-text;
                select-swatch(i) => {
                    ColorChrome.select-swatch(i);
                }
                sb-changed(x, y) => {
                    ColorChrome.sb-changed(x, y);
                }
                hue-changed(x) => {
                    ColorChrome.hue-changed(x);
                }
                hex-changed(text) => {
                    ColorChrome.hex-changed(text);
                }
            }
        }

        if ToolChrome.show-smart-tools: VerticalLayout {
            vertical-stretch: 0;
            spacing: Tokens.space-xs;

            CalmDivider { }

            CalmLabel {
                label: ToolChrome.smart-tools-label;
                horizontal-alignment: center;
            }

            SmartAction {
                text: ToolChrome.remove-background-label;
                enabled: ToolChrome.remove-background-enabled;
                clicked => {
                    ToolChrome.remove-background();
                }
            }
        }

    }
}
