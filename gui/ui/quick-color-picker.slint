import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmMuted } from "calm/CalmText.slint";
import { Tip } from "calm/CalmTip.slint";

component ColorSwatch inherits Rectangle {
    in property <brush> swatch-color;
    in property <bool> active;
    in property <string> tip;
    in property <length> size: 20px;

    callback clicked();

    width: root.size;
    height: root.size;
    horizontal-stretch: 0;
    border-radius: Tokens.radius-sm;
    background: swatch-color;
    border-width: active ? 2px : 1px;
    border-color: active ? Theme.accent-teal : Theme.island-border;

    touch := CalmPointer {
        clicked => {
            Tip.armed = false;
            Tip.open = false;
            root.clicked();
        }
        changed has-hover => {
            if (self.has-hover && root.tip != "") {
                Tip.text = root.tip;
                Tip.shortcut = "";
                Tip.leading = false;
                Tip.x = root.absolute-position.x + root.width + Tokens.space-sm;
                Tip.y = root.absolute-position.y + root.height / 2;
                Tip.open = false;
                Tip.armed = true;
            } else if (Tip.text == root.tip) {
                Tip.armed = false;
                Tip.open = false;
            }
        }
    }
}

component ColorKnob inherits Rectangle {
    width: 10px;
    height: 10px;
    border-radius: self.width / 2;
    background: #FFFFFF;
    border-width: 1px;
    border-color: #00000059;
}

export component QuickColorPicker inherits VerticalLayout {
    in property <brush> swatch0;
    in property <brush> swatch1;
    in property <brush> swatch2;
    in property <brush> swatch3;
    in property <int> active-swatch;
    in property <color> hue-color;
    in property <string> primary-tip;
    in property <string> secondary-tip;
    in property <string> tertiary-tip;
    in property <string> quaternary-tip;

    in-out property <float> sb-x;
    in-out property <float> sb-y;
    in-out property <float> hue-x;
    in-out property <string> hex-text;

    callback select-swatch(int);
    callback sb-changed(float, float);
    callback hue-changed(float);
    callback hex-changed(string);

    spacing: Tokens.space-xs;

    // Toolbar width is fixed (Tokens.tools-panel-width), so the swatches can
    // size themselves to fill it exactly instead of guessing a constant.
    private property <length> swatch-size: (Tokens.tools-panel-width - Tokens.space-xs * 2 - Tokens.space-xs * 3) / 4;

    HorizontalLayout {
        width: 100%;
        height: root.swatch-size;
        spacing: Tokens.space-xs;

        ColorSwatch {
            size: root.swatch-size;
            swatch-color: root.swatch0;
            active: root.active-swatch == 0;
            tip: root.primary-tip;
            clicked => {
                root.select-swatch(0);
            }
        }
        ColorSwatch {
            size: root.swatch-size;
            swatch-color: root.swatch1;
            active: root.active-swatch == 1;
            tip: root.secondary-tip;
            clicked => {
                root.select-swatch(1);
            }
        }
        ColorSwatch {
            size: root.swatch-size;
            swatch-color: root.swatch2;
            active: root.active-swatch == 2;
            tip: root.tertiary-tip;
            clicked => {
                root.select-swatch(2);
            }
        }
        ColorSwatch {
            size: root.swatch-size;
            swatch-color: root.swatch3;
            active: root.active-swatch == 3;
            tip: root.quaternary-tip;
            clicked => {
                root.select-swatch(3);
            }
        }
    }

    Rectangle {
        height: 84px;
        border-radius: Tokens.radius-sm;
        clip: true;

        Rectangle {
            width: 100%;
            height: 100%;
            background: root.hue-color;
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(90deg, #FFFFFF 0%, #FFFFFF00 100%);
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
        }

        sb-touch := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind != PointerEventKind.up && (event.kind == PointerEventKind.down || self.pressed)) {
                    let x = clamp(self.mouse-x / parent.width, 0, 1);
                    let y = clamp(self.mouse-y / parent.height, 0, 1);
                    root.sb-x = x;
                    root.sb-y = y;
                    root.sb-changed(x, y);
                }
            }
        }

        ColorKnob {
            x: root.sb-x * parent.width - self.width / 2;
            y: root.sb-y * parent.height - self.height / 2;
        }
    }

    Rectangle {
        height: 14px;
        border-radius: Tokens.radius-sm;
        clip: true;
        background: @linear-gradient(90deg,
            #FF0000 0%,
            #FFFF00 17%,
            #00FF00 33%,
            #00FFFF 50%,
            #0000FF 67%,
            #FF00FF 83%,
            #FF0000 100%);

        hue-touch := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind != PointerEventKind.up && (event.kind == PointerEventKind.down || self.pressed)) {
                    let x = clamp(self.mouse-x / parent.width, 0, 1);
                    root.hue-x = x;
                    root.hue-changed(x);
                }
            }
        }

        ColorKnob {
            x: root.hue-x * (parent.width - self.width);
            y: (parent.height - self.height) / 2;
        }
    }

    Rectangle {
        height: Tokens.label-size * 2.2;
        border-radius: Tokens.radius-sm;
        background: Theme.surface;
        border-width: 1px;
        border-color: hex-input.has-focus ? Theme.control-focus-border : Theme.control-border;

        HorizontalLayout {
            padding-left: Tokens.space-xs;
            padding-right: Tokens.space-xs;
            spacing: 2px;

            CalmMuted {
                text: "#";
                mono: true;
            }

            hex-input := TextInput {
                text <=> root.hex-text;
                horizontal-stretch: 1;
                height: 100%;
                single-line: true;
                vertical-alignment: center;
                color: Theme.text;
                font-size: Tokens.label-size;
                font-weight: 500;
                font-family: "Menlo";
                selection-background-color: Theme.accent-teal;
                selection-foreground-color: Theme.bg;
                accepted => {
                    root.hex-changed(self.text);
                }
                key-pressed(event) => {
                    if (event.text == "\u{000A}" || event.text == "\u{000D}" || event.text == Key.Return) {
                        root.hex-changed(self.text);
                        accept;
                    }
                    reject;
                }
            }
        }
    }
}
