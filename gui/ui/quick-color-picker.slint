import { LineEdit } from "std-widgets.slint";
import { CalmPointer } from "calm/CalmPointer.slint";

component ColorSwatch inherits Rectangle {
    in property <brush> swatch-color;
    in property <bool> active;
    in property <brush> accent;
    in property <brush> swatch-border;

    callback clicked();

    height: 24px;
    horizontal-stretch: 1;
    border-radius: 4px;
    background: swatch-color;
    border-width: active ? 2px : 1px;
    border-color: active ? accent : swatch-border;

    touch := CalmPointer {
        clicked => { root.clicked(); }
    }
}

export component QuickColorPicker inherits VerticalLayout {
    in property <brush> theme-surface;
    in property <brush> theme-text;
    in property <brush> theme-text-muted;
    in property <brush> theme-accent-teal;
    in property <brush> theme-island-border;
    in property <brush> theme-control-border;
    in property <brush> theme-control-focus-border;

    in property <brush> swatch0;
    in property <brush> swatch1;
    in property <brush> swatch2;
    in property <int> active-swatch;
    in property <brush> hue-color;

    in-out property <float> sb-x;
    in-out property <float> sb-y;
    in-out property <float> hue-x;
    in-out property <string> hex-text;

    callback select-swatch(int);
    callback sb-changed(float, float);
    callback hue-changed(float);
    callback hex-changed(string);

    spacing: 4px;

    HorizontalLayout {
        spacing: 4px;
        ColorSwatch {
            swatch-color: swatch0;
            active: active-swatch == 0;
            accent: theme-accent-teal;
            swatch-border: theme-island-border;
            clicked => { root.select-swatch(0); }
        }
        ColorSwatch {
            swatch-color: swatch1;
            active: active-swatch == 1;
            accent: theme-accent-teal;
            swatch-border: theme-island-border;
            clicked => { root.select-swatch(1); }
        }
        ColorSwatch {
            swatch-color: swatch2;
            active: active-swatch == 2;
            accent: theme-accent-teal;
            swatch-border: theme-island-border;
            clicked => { root.select-swatch(2); }
        }
    }

    Rectangle {
        height: 84px;
        border-radius: 4px;
        clip: true;
        border-width: 1px;
        border-color: theme-island-border;

        Rectangle {
            width: 100%;
            height: 100%;
            background: hue-color;
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
        }

        sb-touch := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind != PointerEventKind.up) {
                    let x = clamp(self.mouse-x / parent.width, 0, 1);
                    let y = clamp(self.mouse-y / parent.height, 0, 1);
                    root.sb-x = x;
                    root.sb-y = y;
                    root.sb-changed(x, y);
                }
            }
        }

        Rectangle {
            x: sb-x * parent.width - 5px;
            y: sb-y * parent.height - 5px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: #ffffff;
            border-width: 1px;
            border-color: #00000059;
        }
    }

    Rectangle {
        height: 14px;
        border-radius: 4px;
        clip: true;
        border-width: 1px;
        border-color: theme-island-border;
        background: @linear-gradient(
            90deg,
            #ff0000 0%,
            #ffff00 17%,
            #00ff00 33%,
            #00ffff 50%,
            #0000ff 67%,
            #ff00ff 83%,
            #ff0000 100%
        );

        hue-touch := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind != PointerEventKind.up) {
                    let x = clamp(self.mouse-x / parent.width, 0, 1);
                    root.hue-x = x;
                    root.hue-changed(x);
                }
            }
        }

        Rectangle {
            x: hue-x * parent.width - 5px;
            y: 2px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: #ffffff;
            border-width: 1px;
            border-color: #00000059;
        }
    }

    Rectangle {
        height: 24px;
        border-radius: 4px;
        border-width: 1px;
        border-color: theme-control-border;
        background: theme-surface;

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 2px;
            Text {
                text: "#";
                color: theme-text-muted;
                font-size: 11px;
                font-family: "Menlo";
                vertical-alignment: center;
            }
            hex-input := LineEdit {
                text <=> root.hex-text;
                font-size: 11px;
                font-family: "Menlo";
                horizontal-stretch: 1;
                edited(text) => { root.hex-changed(text); }
            }
        }
    }
}
