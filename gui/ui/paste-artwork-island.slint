import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmIsland } from "calm/CalmIsland.slint";

export component PasteArtworkIsland inherits CalmIsland {
    in property <string> title-text;
    in property <string> hint-text;
    in property <string> formats-text;
    in property <bool> targeted: false;

    callback clicked();

    private property <image> icon-image: @image-url("image.svg");
    private property <bool> lit: targeted || touch.has-hover;
    private property <float> chroma: lit ? 0.72 : 0.6;

    min-width: Tokens.paste-min-width;
    island-padding: 0px;
    clip: true;
    background: @linear-gradient(135deg,
        Theme.accent-teal.mix(Theme.surface, chroma) 0%,
        Theme.accent-orange.mix(Theme.surface, chroma) 50%,
        Theme.surface 100%);

    touch := CalmPointer {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        padding: Tokens.space-md;
        spacing: Tokens.space-sm;
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Image {
                source: root.icon-image;
                width: Tokens.space-xl;
                height: Tokens.space-xl;
                colorize: Theme.text;
            }
        }

        Text {
            text: root.title-text;
            font-size: Tokens.body-size;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }

        Text {
            text: root.hint-text;
            font-size: Tokens.label-size;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Text {
            text: root.formats-text;
            font-size: Tokens.label-size;
            font-weight: 500;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
