import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmIsland } from "calm/CalmIsland.slint";

export component PasteArtworkIsland inherits Rectangle {
    in property <brush> theme-accent-teal;
    in property <brush> theme-accent-orange;
    in property <brush> theme-island-border;
    in property <brush> theme-text;
    in property <brush> theme-text-muted;

    in property <string> title-text;
    in property <string> hint-text;
    in property <string> formats-text;

    callback clicked();

    private property <image> icon-image: @image-url("image.svg");

    min-width: 200px;
    max-width: 420px;
    horizontal-stretch: 1;

    island-touch := CalmPointer {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    CalmIsland {
        width: 100%;
        height: 100%;
        border-color: theme-island-border;
        island-padding: 0px;
        background: @linear-gradient(135deg, theme-accent-teal 0%, theme-accent-orange 100%);
        opacity: island-touch.has-hover ? 1.0 : 0.82;

        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: center;

            Image {
                source: icon-image;
                width: 32px;
                height: 32px;
                colorize: theme-text;
                horizontal-alignment: center;
            }

            Text {
                text: title-text;
                font-size: 15px;
                font-weight: 700;
                color: theme-text;
                horizontal-alignment: center;
            }

            Text {
                text: hint-text;
                font-size: 11px;
                color: theme-text-muted;
                horizontal-alignment: center;
            }

            Text {
                text: formats-text;
                font-size: 10px;
                color: theme-text-muted;
                horizontal-alignment: center;
            }
        }
    }
}
