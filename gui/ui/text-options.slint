import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmToolButton } from "calm/CalmToolButton.slint";
import { CalmSliderRow } from "calm/CalmSliderRow.slint";
import { CalmField } from "calm/CalmField.slint";
import { CalmMuted } from "calm/CalmText.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmScrollView } from "calm/CalmScrollView.slint";
import { FontFamilyRow } from "models.slint";
import { ToolChrome } from "tool-chrome.slint";

component FontPicker inherits Rectangle {
    in property <string> family;
    in property <[FontFamilyRow]> families;
    in property <string> empty-label;
    in-out property <string> query;

    callback search(string);
    callback pick(string);

    height: Tokens.control-height;
    border-radius: Tokens.radius-sm;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.control-border;

    label := Text {
        x: Tokens.space-xs;
        width: parent.width - Tokens.space-xs * 2;
        height: 100%;
        text: root.family;
        color: Theme.text;
        font-size: Tokens.label-size;
        font-weight: 500;
        overflow: elide;
        vertical-alignment: center;
    }

    CalmPointer {
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: 0px;
        y: root.height + Tokens.space-xs;
        width: root.width;

        Rectangle {
            background: Theme.surface;
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: Theme.island-border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.shadow;
            clip: true;

            VerticalLayout {
                padding: Tokens.space-xs;
                spacing: Tokens.space-xs;

                CalmField {
                    text <=> root.query;
                    edited(text) => {
                        root.search(text);
                    }
                }

                if root.families.length == 0: CalmMuted {
                    text: root.empty-label;
                    horizontal-alignment: center;
                }

                if root.families.length > 0: CalmScrollView {
                    height: 160px;

                    VerticalLayout {
                        spacing: 1px;

                        for family in root.families: Rectangle {
                            height: Tokens.control-height;
                            border-radius: Tokens.radius-sm;
                            background: row-touch.has-hover ? Theme.surface-hover : transparent;

                            row-touch := CalmPointer {
                                clicked => {
                                    root.pick(family.name);
                                    popup.close();
                                }
                            }

                            Text {
                                x: Tokens.space-xs;
                                width: parent.width - Tokens.space-xs * 2;
                                height: 100%;
                                text: family.name;
                                color: Theme.text;
                                font-size: Tokens.label-size;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component TextOptions inherits VerticalLayout {
    spacing: Tokens.space-xs;

    private property <image> icon-bold: @image-url("bold.svg");
    private property <image> icon-italic: @image-url("italic.svg");
    private property <image> icon-align-left: @image-url("align-left.svg");
    private property <image> icon-align-center: @image-url("align-center.svg");
    private property <image> icon-align-right: @image-url("align-right.svg");

    CalmMuted {
        text: ToolChrome.text-font-label;
    }

    FontPicker {
        family: ToolChrome.text-family;
        families: ToolChrome.font-families;
        empty-label: ToolChrome.text-no-fonts-label;
        query <=> ToolChrome.text-font-query;
        search(text) => {
            ToolChrome.text-font-search(text);
        }
        pick(name) => {
            ToolChrome.text-family-changed(name);
        }
    }

    CalmSliderRow {
        label: ToolChrome.text-size-label;
        value-text <=> ToolChrome.text-size-text;
        editable: true;
        value <=> ToolChrome.text-size-unit;
        moved(v) => {
            ToolChrome.text-size-changed(v);
        }
        committed(text) => {
            ToolChrome.text-size-committed(text);
        }
    }

    CalmSliderRow {
        label: ToolChrome.text-line-height-label;
        value-text: ToolChrome.text-line-height-text;
        minimum: ToolChrome.text-line-height-min;
        maximum: ToolChrome.text-line-height-max;
        value <=> ToolChrome.text-line-height;
        moved(v) => {
            ToolChrome.text-line-height-changed(v);
        }
    }

    if ToolChrome.text-wrap-max > 0: CalmSliderRow {
        label: ToolChrome.text-wrap-label;
        value-text: ToolChrome.text-wrap-text;
        minimum: 0;
        maximum: ToolChrome.text-wrap-max;
        value <=> ToolChrome.text-wrap-width;
        moved(v) => {
            ToolChrome.text-wrap-changed(v);
        }
    }

    HorizontalLayout {
        spacing: Tokens.tool-grid-gap;

        Rectangle {
            horizontal-stretch: 1;
            height: Tokens.tool-button-size;

            CalmToolButton {
                x: (parent.width - self.width) / 2;
                icon: root.icon-bold;
                tip: ToolChrome.text-bold-label;
                enabled: ToolChrome.text-can-bold;
                selected: ToolChrome.text-bold;
                clicked => {
                    ToolChrome.text-bold-toggled();
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: Tokens.tool-button-size;

            CalmToolButton {
                x: (parent.width - self.width) / 2;
                icon: root.icon-italic;
                tip: ToolChrome.text-italic-label;
                enabled: ToolChrome.text-can-italic;
                selected: ToolChrome.text-italic;
                clicked => {
                    ToolChrome.text-italic-toggled();
                }
            }
        }
    }

    HorizontalLayout {
        spacing: Tokens.tool-grid-gap;

        Rectangle {
            horizontal-stretch: 1;
            height: Tokens.tool-button-size;

            CalmToolButton {
                x: (parent.width - self.width) / 2;
                icon: root.icon-align-left;
                tip: ToolChrome.text-align-left-label;
                selected: ToolChrome.text-align == 0;
                clicked => {
                    ToolChrome.text-align-changed(0);
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: Tokens.tool-button-size;

            CalmToolButton {
                x: (parent.width - self.width) / 2;
                icon: root.icon-align-center;
                tip: ToolChrome.text-align-center-label;
                selected: ToolChrome.text-align == 1;
                clicked => {
                    ToolChrome.text-align-changed(1);
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: Tokens.tool-button-size;

            CalmToolButton {
                x: (parent.width - self.width) / 2;
                icon: root.icon-align-right;
                tip: ToolChrome.text-align-right-label;
                selected: ToolChrome.text-align == 2;
                clicked => {
                    ToolChrome.text-align-changed(2);
                }
            }
        }
    }
}
