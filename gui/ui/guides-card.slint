import { GuideChrome } from "guide-chrome.slint";
import { GuideRow } from "models.slint";
import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmModal, CalmModalCard } from "calm/CalmModal.slint";
import { CalmButton } from "calm/CalmButton.slint";
import { CalmField } from "calm/CalmField.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmDot } from "calm/CalmDot.slint";
import { CalmPaletteRow } from "calm/CalmPaletteRow.slint";
import { CalmMuted, CalmTitle } from "calm/CalmText.slint";
import { CalmScrollView } from "calm/CalmScrollView.slint";
import { CalmIconButton } from "calm/CalmToolButton.slint";
import { CalmDivider } from "calm/CalmDivider.slint";

component EdgeChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;

    callback clicked();

    height: Tokens.control-height;
    border-radius: Tokens.radius-sm;
    background: selected ? Theme.surface-hover : transparent;

    touch := CalmPointer {
        clicked => {
            root.clicked();
        }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        color: selected ? Theme.text : Theme.text-muted;
        font-size: Tokens.label-size;
        font-weight: selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component GuidesCard inherits Rectangle {
    in-out property <bool> open;
    in property <bool> dim-scrim: true;
    in property <[color]> palette;


    private property <image> icon-trash: @image-url("trash.svg");
    private property <int> picker-guide: -1;
    private property <int> picker-selected: 0;
    private property <length> picker-x: 0px;
    private property <length> picker-y: 0px;

    out property <length> card-x: card.absolute-position.x;
    out property <length> card-y: card.absolute-position.y;
    out property <length> card-width: card.width;
    out property <length> card-height: card.height;
    out property <length> card-radius: card.border-radius;

    width: 100%;
    height: 100%;
    visible: open;

    CalmModal {
        open <=> root.open;
        dim-scrim: root.dim-scrim;
        dismissed => {
            GuideChrome.dismissed();
        }

        card := CalmModalCard {
            z: 1;
            width: min(Tokens.guides-card-width, parent.width - Tokens.space-xl * 2);
            height: min(Tokens.guides-card-max-height, parent.height - Tokens.space-xl * 2);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            clip: false;

            VerticalLayout {
                padding: Tokens.space-lg;
                spacing: Tokens.space-md;

                HorizontalLayout {
                    CalmTitle {
                        text: GuideChrome.title-text;
                        strong: true;
                        horizontal-stretch: 1;
                    }
                    close-touch := CalmPointer {
                        width: Tokens.space-lg;
                        Text {
                            text: "×";
                            font-size: Tokens.title-size;
                            color: close-touch.has-hover ? Theme.text : Theme.text-muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        clicked => {
                            root.open = false;
                            GuideChrome.dismissed();
                        }
                    }
                }

                CalmMuted {
                    text: GuideChrome.hint-text;
                }

                if GuideChrome.guides.length == 0: CalmMuted {
                    text: GuideChrome.empty-text;
                    vertical-stretch: 1;
                }

                if GuideChrome.guides.length > 0: CalmScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: Tokens.space-sm;
                        alignment: start;

                        for row in GuideChrome.guides: HorizontalLayout {
                            spacing: Tokens.space-sm;
                            height: Tokens.control-height;

                            EdgeChip {
                                text: GuideChrome.top-label;
                                selected: row.horizontal;
                                width: 44px;
                                clicked => {
                                    GuideChrome.set-axis(row.index, true);
                                }
                            }
                            EdgeChip {
                                text: GuideChrome.left-label;
                                selected: !row.horizontal;
                                width: 44px;
                                clicked => {
                                    GuideChrome.set-axis(row.index, false);
                                }
                            }

                            CalmField {
                                horizontal-stretch: 1;
                                text: row.offset-text;
                                mono: true;
                                accepted(text) => {
                                    GuideChrome.set-offset(row.index, text);
                                }
                            }

                            Rectangle {
                                width: Tokens.control-height;
                                height: Tokens.control-height;

                                CalmDot {
                                    dot-color: row.color;
                                    dot-size: Tokens.control-height;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                CalmPointer {
                                    clicked => {
                                        root.picker-guide = row.index;
                                        root.picker-selected = row.palette-index;
                                        root.picker-x = self.absolute-position.x - root.absolute-position.x;
                                        root.picker-y = self.absolute-position.y - root.absolute-position.y + parent.height + Tokens.space-xs;
                                        picker.show();
                                    }
                                }
                            }

                            CalmIconButton {
                                icon: root.icon-trash;
                                tip: GuideChrome.delete-tip;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    GuideChrome.remove-guide(row.index);
                                }
                            }
                        }
                    }
                }

                CalmDivider { }

                HorizontalLayout {
                    spacing: Tokens.space-sm;

                    EdgeChip {
                        text: GuideChrome.top-label;
                        selected: GuideChrome.add-horizontal;
                        width: 44px;
                        clicked => {
                            GuideChrome.add-horizontal = true;
                        }
                    }
                    EdgeChip {
                        text: GuideChrome.left-label;
                        selected: !GuideChrome.add-horizontal;
                        width: 44px;
                        clicked => {
                            GuideChrome.add-horizontal = false;
                        }
                    }
                    CalmField {
                        horizontal-stretch: 1;
                        text <=> GuideChrome.add-offset;
                        mono: true;
                        accepted(text) => {
                            GuideChrome.add-offset = text;
                            if (GuideChrome.can-add) {
                                GuideChrome.add-guide();
                            }
                        }
                    }
                    Rectangle {
                        width: Tokens.control-height;
                        height: Tokens.control-height;
                        border-radius: self.height / 2;
                        background: root.palette.length > 1 ? root.palette[1] : Theme.accent-teal;
                    }
                    CalmButton {
                        text: GuideChrome.add-label;
                        enabled: GuideChrome.can-add;
                        clicked => {
                            GuideChrome.add-guide();
                        }
                    }
                }

                if !GuideChrome.can-add: CalmMuted {
                    text: GuideChrome.full-text;
                }

                CalmButton {
                    text: GuideChrome.clear-label;
                    enabled: GuideChrome.guides.length > 0;
                    fill: true;
                    clicked => {
                        GuideChrome.clear-guides();
                    }
                }
            }
        }
    }

    picker := PopupWindow {
        close-policy: close-on-click-outside;
        x: min(max(Tokens.space-sm, root.picker-x - flyout.preferred-width - Tokens.space-lg - 20px), parent.width - flyout.preferred-width - Tokens.space-sm);
        y: min(max(Tokens.space-sm, root.picker-y), parent.height - flyout.preferred-height - Tokens.space-sm);
        width: flyout.preferred-width;
        height: flyout.preferred-height;

        flyout := Rectangle {
            width: flyout-row.preferred-width + Tokens.space-sm * 2;
            height: flyout-row.preferred-height + Tokens.space-sm * 2;
            background: Theme.bg;
            border-radius: Tokens.radius-md;
            border-width: 1px;
            border-color: Theme.island-border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.shadow;

            flyout-row := HorizontalLayout {
                x: Tokens.space-sm;
                y: Tokens.space-sm;
                width: self.preferred-width;
                height: self.preferred-height;
                padding: 0px;

                CalmPaletteRow {
                    palette: root.palette;
                    selected-index: root.picker-selected;
                    picked(index) => {
                        GuideChrome.set-color(root.picker-guide, index);
                        picker.close();
                    }
                }
            }
        }
    }
}
