import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmDivider } from "calm/CalmDivider.slint";
import { CalmButton } from "calm/CalmButton.slint";
import { CalmToggle } from "calm/CalmToggle.slint";
import { CalmSliderRow } from "calm/CalmSliderRow.slint";
import { CalmBody, CalmMuted } from "calm/CalmText.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmField } from "calm/CalmField.slint";
import { CalmSectionLabel } from "calm/CalmSectionLabel.slint";
import { LayerChrome } from "layer-chrome.slint";
import { CalmSelect } from "calm/CalmSelect.slint";

export component LayerSettingsBody inherits VerticalLayout {
    in property <bool> compact: false;


    spacing: Tokens.space-md;
    alignment: start;

    if LayerChrome.can-rename: CalmField {
        text: LayerChrome.name;
        accepted(text) => {
            LayerChrome.rename-layer(text);
        }
    }

    if !LayerChrome.can-rename: CalmBody {
        text: LayerChrome.name;
        strong: true;
        overflow: elide;
    }

    if !root.compact: Rectangle {
        height: 120px;
        border-radius: Tokens.radius-sm;
        background: Theme.surface-hover;
        clip: true;

        Image {
            source: LayerChrome.preview;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }
    }

    HorizontalLayout {
        CalmMuted {
            text: LayerChrome.visibility-label;
            horizontal-stretch: 1;
        }
        CalmToggle {
            checked: LayerChrome.visible;
            y: (parent.height - self.height) / 2;
            toggled => {
                LayerChrome.toggle-visibility();
            }
        }
    }

    HorizontalLayout {
        CalmMuted {
            text: LayerChrome.lock-label;
            horizontal-stretch: 1;
        }
        CalmToggle {
            checked: LayerChrome.locked;
            y: (parent.height - self.height) / 2;
            toggled => {
                LayerChrome.toggle-lock();
            }
        }
    }

    CalmSliderRow {
        label: LayerChrome.opacity-label;
        value-text: LayerChrome.opacity-text;
        value <=> LayerChrome.opacity;
        moved(v) => {
            LayerChrome.opacity-changed(v);
        }
        released(v) => {
            LayerChrome.opacity-committed(v);
        }
    }

    CalmMuted {
        text: LayerChrome.blend-label;
    }

    CalmSelect {
        options: LayerChrome.blend-options;
        value: LayerChrome.blend;
        current-label: LayerChrome.blend-current-label;
        picked(mode) => {
            LayerChrome.blend-changed(mode);
        }
    }

    if root.compact: VerticalLayout {
        spacing: Tokens.space-xs;

        HorizontalLayout {
            spacing: Tokens.space-xs;

            if LayerChrome.can-clip || LayerChrome.clipped: CalmButton {
                text: LayerChrome.clip-label;
                fill: true;
                enabled: LayerChrome.can-clip;
                clicked => {
                    LayerChrome.toggle-clip();
                }
            }

            if LayerChrome.can-mask || LayerChrome.masked: CalmButton {
                text: LayerChrome.mask-label;
                fill: true;
                enabled: LayerChrome.can-mask;
                clicked => {
                    LayerChrome.toggle-mask();
                }
            }

            CalmButton {
                text: LayerChrome.merge-label;
                fill: true;
                enabled: LayerChrome.can-merge;
                clicked => {
                    LayerChrome.merge-down();
                }
            }
        }

        HorizontalLayout {
            spacing: Tokens.space-xs;

            CalmButton {
                text: LayerChrome.duplicate-label;
                fill: true;
                clicked => {
                    LayerChrome.duplicate-layer();
                }
            }

            if LayerChrome.can-delete: CalmButton {
                text: LayerChrome.delete-label;
                fill: true;
                has-tint: true;
                tint: Theme.danger;
                clicked => {
                    LayerChrome.delete-layer();
                }
            }
        }
    }

    if !root.compact: VerticalLayout {
        spacing: Tokens.space-md;

        CalmSectionLabel {
            label: LayerChrome.filters-label;
            has-accent: false;
        }

        CalmSliderRow {
            label: LayerChrome.brightness-label;
            value-text: LayerChrome.brightness-text;
            minimum: -1;
            maximum: 1;
            value <=> LayerChrome.brightness;
            moved(v) => {
                LayerChrome.filter-changed(0, v);
            }
            released(v) => {
                LayerChrome.filter-committed(0, v);
            }
        }

        CalmSliderRow {
            label: LayerChrome.contrast-label;
            value-text: LayerChrome.contrast-text;
            minimum: -1;
            maximum: 1;
            value <=> LayerChrome.contrast;
            moved(v) => {
                LayerChrome.filter-changed(1, v);
            }
            released(v) => {
                LayerChrome.filter-committed(1, v);
            }
        }

        CalmSliderRow {
            label: LayerChrome.vibrance-label;
            value-text: LayerChrome.vibrance-text;
            minimum: -1;
            maximum: 1;
            value <=> LayerChrome.vibrance;
            moved(v) => {
                LayerChrome.filter-changed(2, v);
            }
            released(v) => {
                LayerChrome.filter-committed(2, v);
            }
        }

        CalmSliderRow {
            label: LayerChrome.saturation-label;
            value-text: LayerChrome.saturation-text;
            minimum: -1;
            maximum: 1;
            value <=> LayerChrome.saturation;
            moved(v) => {
                LayerChrome.filter-changed(3, v);
            }
            released(v) => {
                LayerChrome.filter-committed(3, v);
            }
        }

        CalmSliderRow {
            label: LayerChrome.gamma-label;
            value-text: LayerChrome.gamma-text;
            minimum: 0.1;
            maximum: 4;
            value <=> LayerChrome.gamma;
            moved(v) => {
                LayerChrome.filter-changed(4, v);
            }
            released(v) => {
                LayerChrome.filter-committed(4, v);
            }
        }

        CalmSliderRow {
            label: LayerChrome.hue-label;
            value-text: LayerChrome.hue-text;
            minimum: -180;
            maximum: 180;
            value <=> LayerChrome.hue;
            moved(v) => {
                LayerChrome.filter-changed(5, v);
            }
            released(v) => {
                LayerChrome.filter-committed(5, v);
            }
        }

        CalmButton {
            text: LayerChrome.reset-filters-label;
            fill: true;
            clicked => {
                LayerChrome.reset-filters();
            }
        }

        CalmDivider { }

        if LayerChrome.can-clip || LayerChrome.clipped: CalmButton {
            text: LayerChrome.clip-label;
            fill: true;
            enabled: LayerChrome.can-clip;
            clicked => {
                LayerChrome.toggle-clip();
            }
        }

        if LayerChrome.can-mask || LayerChrome.masked: CalmButton {
            text: LayerChrome.mask-label;
            fill: true;
            enabled: LayerChrome.can-mask;
            clicked => {
                LayerChrome.toggle-mask();
            }
        }

        if LayerChrome.can-flatten: CalmButton {
            text: LayerChrome.flatten-label;
            fill: true;
            clicked => {
                LayerChrome.flatten-clip();
            }
        }

        CalmButton {
            text: LayerChrome.merge-label;
            fill: true;
            enabled: LayerChrome.can-merge;
            clicked => {
                LayerChrome.merge-down();
            }
        }

        CalmButton {
            text: LayerChrome.reset-transform-label;
            fill: true;
            enabled: LayerChrome.can-reset-transform;
            clicked => {
                LayerChrome.reset-transform();
            }
        }

        HorizontalLayout {
            spacing: Tokens.space-xs;

            CalmButton {
                text: LayerChrome.move-up-label;
                fill: true;
                enabled: LayerChrome.can-move-up;
                clicked => {
                    LayerChrome.move-up();
                }
            }

            CalmButton {
                text: LayerChrome.move-down-label;
                fill: true;
                enabled: LayerChrome.can-move-down;
                clicked => {
                    LayerChrome.move-down();
                }
            }
        }

        if LayerChrome.can-rasterize: CalmButton {
            text: LayerChrome.rasterize-label;
            fill: true;
            clicked => {
                LayerChrome.rasterize-layer();
            }
        }

        CalmDivider { }

        CalmButton {
            text: LayerChrome.export-label;
            fill: true;
            clicked => {
                LayerChrome.export-layer();
            }
        }

        CalmButton {
            text: LayerChrome.duplicate-label;
            fill: true;
            clicked => {
                LayerChrome.duplicate-layer();
            }
        }

        if LayerChrome.can-delete: CalmDivider { }

        if LayerChrome.can-delete: CalmButton {
            text: LayerChrome.delete-label;
            fill: true;
            has-tint: true;
            tint: Theme.danger;
            clicked => {
                LayerChrome.delete-layer();
            }
        }
    }
}
