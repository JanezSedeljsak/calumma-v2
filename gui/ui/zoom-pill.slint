import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmIconButton } from "calm/CalmToolButton.slint";
import { CalmSlider } from "calm/CalmSlider.slint";
import { CalmMuted } from "calm/CalmText.slint";
import { Tip } from "calm/CalmTip.slint";

component ZoomStep inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;

    callback clicked();

    width: 18px;
    height: 18px;

    touch := CalmPointer {
        clicked => {
            Tip.armed = false;
            Tip.open = false;
            root.clicked();
        }
        changed has-hover => {
            if (self.has-hover && root.tip != "") {
                Tip.text = root.tip;
                Tip.shortcut = "";
                Tip.leading = true;
                Tip.x = root.absolute-position.x - Tokens.space-sm;
                Tip.y = root.absolute-position.y + root.height / 2;
                Tip.open = false;
                Tip.armed = true;
            } else if (Tip.text == root.tip) {
                Tip.armed = false;
                Tip.open = false;
            }
        }
    }

    Text {
        text: root.glyph;
        width: 100%;
        height: 100%;
        font-size: Tokens.title-size;
        font-weight: 500;
        color: touch.has-hover ? Theme.text : Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ZoomPill inherits Rectangle {
    in-out property <float> zoom-unit;
    in property <string> zoom-text;
    in property <bool> is-fit;
    in property <string> zoom-in-tip;
    in property <string> zoom-out-tip;
    in property <string> fit-tip;

    callback zoom-changed(float);
    callback step-zoom(bool);
    callback fit-zoom();

    private property <image> icon-fit: @image-url("fit-to-view.svg");

    width: pill.preferred-width;
    height: pill.preferred-height;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.island-border;
    border-radius: Tokens.radius-island;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.shadow;

    pill := HorizontalLayout {
        padding-left: Tokens.space-sm;
        padding-right: Tokens.space-sm;
        padding-top: Tokens.space-xs;
        padding-bottom: Tokens.space-xs;
        spacing: Tokens.space-xs;

        ZoomStep {
            glyph: "−";
            tip: root.zoom-out-tip;
            clicked => {
                root.step-zoom(false);
            }
        }

        CalmSlider {
            width: 96px;
            minimum: 0;
            maximum: 1;
            value <=> root.zoom-unit;
            moved(v) => {
                root.zoom-changed(v);
            }
        }

        ZoomStep {
            glyph: "+";
            tip: root.zoom-in-tip;
            clicked => {
                root.step-zoom(true);
            }
        }

        CalmMuted {
            text: root.zoom-text;
            mono: true;
            width: 40px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        CalmIconButton {
            icon: root.icon-fit;
            tint: root.is-fit ? Theme.accent-teal : Theme.text-muted;
            opacity: root.is-fit ? 1.0 : Tokens.disabled-opacity;
            tip: root.fit-tip;
            clicked => {
                root.fit-zoom();
            }
        }
    }
}
