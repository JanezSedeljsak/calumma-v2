import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";
import { CalmIsland } from "calm/CalmIsland.slint";
import { CalmPointer } from "calm/CalmPointer.slint";
import { CalmIconButton } from "calm/CalmToolButton.slint";
import { CalmSlider } from "calm/CalmSlider.slint";
import { CalmMuted } from "calm/CalmText.slint";

component ZoomStep inherits Rectangle {
    in property <string> glyph;
    in property <string> tip;

    callback clicked();

    width: 18px;
    height: 18px;

    touch := CalmPointer {
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.glyph;
        width: 100%;
        height: 100%;
        font-size: Tokens.title-size;
        font-weight: 500;
        color: touch.has-hover ? Theme.text : Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ZoomPill inherits CalmIsland {
    in-out property <float> zoom-unit;
    in property <string> zoom-text;
    in property <bool> is-fit;
    in property <string> zoom-in-tip;
    in property <string> zoom-out-tip;
    in property <string> fit-tip;

    callback zoom-changed(float);
    callback step-zoom(bool);
    callback fit-zoom();

    private property <image> icon-fit: @image-url("fit-to-view.svg");

    background: Theme.surface-hover;
    island-padding: Tokens.space-sm;
    width: pill.preferred-width + self.island-padding * 2;
    height: pill.preferred-height + self.island-padding * 2;

    pill := HorizontalLayout {
        x: root.island-padding;
        y: root.island-padding;
        width: parent.width - root.island-padding * 2;
        height: parent.height - root.island-padding * 2;
        spacing: Tokens.space-sm;

        ZoomStep {
            glyph: "−";
            tip: root.zoom-out-tip;
            y: (parent.height - self.height) / 2;
            clicked => {
                root.step-zoom(false);
            }
        }

        CalmSlider {
            width: 96px;
            minimum: 0;
            maximum: 1;
            value <=> root.zoom-unit;
            moved(v) => {
                root.zoom-changed(v);
            }
        }

        ZoomStep {
            glyph: "+";
            tip: root.zoom-in-tip;
            y: (parent.height - self.height) / 2;
            clicked => {
                root.step-zoom(true);
            }
        }

        CalmMuted {
            text: root.zoom-text;
            mono: true;
            width: 40px;
            horizontal-alignment: right;
        }

        CalmIconButton {
            icon: root.icon-fit;
            tint: root.is-fit ? Theme.accent-teal : Theme.text-muted;
            tip: root.fit-tip;
            y: (parent.height - self.height) / 2;
            clicked => {
                root.fit-zoom();
            }
        }
    }
}
