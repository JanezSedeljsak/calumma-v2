import { Theme } from "calm/CalmTheme.slint";
import { Tokens } from "calm/CalmTokens.slint";

export struct RulerTickRow {
    offset: length,
    label: string,
    major: bool,
}

export component RulerStrip inherits Rectangle {
    in property <bool> vertical: false;
    in property <[RulerTickRow]> ticks;

    callback guide-pressed(length, length);
    callback guide-moved(length, length);
    callback guide-released();
    callback has-guide(length, length) -> bool;

    private property <length> major-length: Tokens.ruler-thickness * 0.55;
    private property <length> minor-length: Tokens.ruler-thickness * 0.28;
    private property <length> label-box: Tokens.ruler-thickness * 2.4;
    private property <bool> over-guide: false;
    private property <bool> dark-theme: Theme.text.red > Theme.surface.red;

    background: Theme.surface;
    clip: false;

    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        for tick in root.ticks: Rectangle {
            x: root.vertical ? root.width - (tick.major ? root.major-length : root.minor-length) : tick.offset;
            y: root.vertical ? tick.offset : root.height - (tick.major ? root.major-length : root.minor-length);
            width: root.vertical ? (tick.major ? root.major-length : root.minor-length) : 1px;
            height: root.vertical ? 1px : (tick.major ? root.major-length : root.minor-length);
            background: tick.major ? Theme.text-muted : Theme.text;
            opacity: tick.major ? 1.0 : (root.dark-theme ? 0.82 : 0.45);
        }
    }

    for tick in root.ticks: Text {
        visible: tick.major;
        width: root.vertical ? root.label-box : self.preferred-width;
        height: Tokens.label-size + 2px;
        x: root.vertical ? 0px : tick.offset + 3px;
        y: root.vertical ? tick.offset - self.height / 2 : 1px;
        transform-origin: root.vertical ? { x: root.width / 2, y: self.height / 2 } : { x: 0px, y: 0px };
        transform-rotation: root.vertical ? -90deg : 0deg;
        text: tick.label;
        font-size: Tokens.label-size;
        font-weight: 500;
        wrap: no-wrap;
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.over-guide
            ? (root.vertical ? MouseCursor.ns-resize : MouseCursor.ew-resize)
            : (root.vertical ? MouseCursor.ew-resize : MouseCursor.ns-resize);

        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    root.guide-pressed(self.mouse-x, self.mouse-y);
                } else if (event.kind == PointerEventKind.up) {
                    root.guide-released();
                }
            }
        }

        moved => {
            if (self.pressed) {
                root.guide-moved(self.mouse-x, self.mouse-y);
            } else {
                root.over-guide = root.has-guide(self.mouse-x, self.mouse-y);
            }
        }

        changed has-hover => {
            if (self.has-hover) {
                root.over-guide = root.has-guide(self.mouse-x, self.mouse-y);
            } else {
                root.over-guide = false;
            }
        }
    }
}
