export global LayerChrome {
    in-out property <string> name;
    in-out property <image> preview;
    in-out property <bool> visible: true;
    in-out property <bool> locked: false;
    in-out property <bool> can-delete: true;
    in-out property <bool> can-rename: true;
    in-out property <float> opacity: 1;
    in-out property <string> opacity-text;
    in-out property <int> blend: 0;

    in-out property <float> brightness: 0;
    in-out property <float> contrast: 0;
    in-out property <float> vibrance: 0;
    in-out property <float> saturation: 0;
    in-out property <float> gamma: 1;
    in-out property <float> hue: 0;
    in-out property <string> brightness-text;
    in-out property <string> contrast-text;
    in-out property <string> vibrance-text;
    in-out property <string> saturation-text;
    in-out property <string> gamma-text;
    in-out property <string> hue-text;

    in-out property <bool> clipped: false;
    in-out property <bool> can-clip: false;
    in-out property <bool> can-flatten: false;
    in-out property <bool> can-merge: false;
    in-out property <bool> can-reset-transform: false;
    in-out property <bool> can-move-up: false;
    in-out property <bool> can-move-down: false;
    in-out property <bool> can-rasterize: false;

    in-out property <string> visibility-label;
    in-out property <string> lock-label;
    in-out property <string> opacity-label;
    in-out property <string> blend-label;
    in-out property <string> blend-normal-label;
    in-out property <string> blend-multiply-label;
    in-out property <string> blend-screen-label;
    in-out property <string> filters-label;
    in-out property <string> brightness-label;
    in-out property <string> contrast-label;
    in-out property <string> vibrance-label;
    in-out property <string> saturation-label;
    in-out property <string> gamma-label;
    in-out property <string> hue-label;
    in-out property <string> reset-filters-label;
    in-out property <string> rename-label;
    in-out property <string> clip-label;
    in-out property <string> flatten-label;
    in-out property <string> merge-label;
    in-out property <string> reset-transform-label;
    in-out property <string> move-up-label;
    in-out property <string> move-down-label;
    in-out property <string> rasterize-label;
    in-out property <string> export-label;
    in-out property <string> duplicate-label;
    in-out property <string> delete-label;
}
